@{
    Layout = null; // Login page has its own full-page design, no sidebar layout
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login — Faculty Management System</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Lexend:wght@600;700&display=swap" rel="stylesheet" />
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans:['Inter','system-ui','sans-serif'], display:['Lexend','Inter','sans-serif'] },
                    colors: { brand:{ 50:'#eef2ff',100:'#e0e7ff',200:'#c7d2fe',400:'#818cf8',500:'#6366f1',600:'#4f46e5',700:'#4338ca',800:'#3730a3',900:'#312e81',950:'#1e1b4b' } }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Inter',sans-serif;
        }

        .orb {
            position: absolute;
            border-radius: 9999px;
            filter: blur(80px);
            opacity: 0.55;
            animation: drift 10s ease-in-out infinite alternate;
        }

        .orb-1 {
            width: 480px;
            height: 480px;
            background: radial-gradient(circle,#6366f1,#4338ca);
            top: -120px;
            left: -120px;
            animation-duration: 12s;
        }

        .orb-2 {
            width: 360px;
            height: 360px;
            background: radial-gradient(circle,#38bdf8,#0ea5e9);
            bottom: -80px;
            right: -80px;
            animation-duration: 9s;
            animation-delay: -3s;
        }

        .orb-3 {
            width: 220px;
            height: 220px;
            background: radial-gradient(circle,#a78bfa,#7c3aed);
            top: 40%;
            left: 55%;
            animation-duration: 14s;
            animation-delay: -6s;
            opacity: 0.3;
        }
        @@keyframes drift {
            from

        {
            transform: translate(0,0) scale(1);
        }

        to {
            transform: translate(30px,20px) scale(1.05);
        }

        }

        .bg-grid {
            background-image: linear-gradient(rgba(255,255,255,0.04) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,0.04) 1px,transparent 1px);
            background-size: 40px 40px;
        }

        .input-field {
            outline: none;
            border: 1.5px solid #e0e7ff;
            transition: border-color 0.2s ease,box-shadow 0.2s ease;
        }

            .input-field:focus {
                border-color: #6366f1;
                box-shadow: 0 0 0 3px rgba(99,102,241,0.12);
            }

        .btn-primary {
            background: linear-gradient(135deg,#6366f1 0%,#38bdf8 100%);
            transition: all 0.2s ease;
            box-shadow: 0 4px 16px rgba(99,102,241,0.35);
        }

            .btn-primary:hover {
                transform: translateY(-1px);
                box-shadow: 0 8px 24px rgba(99,102,241,0.45);
            }

        .fade-up {
            animation: fadeUp 0.5s ease forwards;
        }
        @@keyframes fadeUp {
            from

        {
            opacity: 0;
            transform: translateY(16px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }

        .role-badge {
            cursor: pointer;
            border: 1.5px solid #e0e7ff;
            transition: all 0.18s ease;
        }

            .role-badge:hover {
                border-color: #6366f1;
                background: #eef2ff;
            }

            .role-badge.selected {
                border-color: #6366f1;
                background: #eef2ff;
            }

                .role-badge.selected .role-dot {
                    background: #6366f1;
                }

        .role-dot {
            width: 8px;
            height: 8px;
            border-radius: 9999px;
            background: #c7d2fe;
            transition: background 0.18s;
        }

        .stat-strip {
            border-top: 1px solid rgba(255,255,255,0.1);
        }

        /* Validation error style */
        .field-error {
            color: #ef4444;
            font-size: 0.75rem;
            margin-top: 0.25rem;
        }

        .input-error {
            border-color: #ef4444 !important;
        }

        /* Hide browser's native password reveal button */
        input[type="password"]::-ms-reveal,
        input[type="password"]::-ms-clear,
        input[type="password"]::-webkit-contacts-auto-fill-button,
        input[type="password"]::-webkit-credentials-auto-fill-button {
            display: none !important;
        }

    </style>
</head>
<body class="min-h-screen bg-brand-950 relative overflow-hidden flex items-center justify-center p-4">

    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="orb orb-3"></div>
    <div class="absolute inset-0 bg-grid pointer-events-none"></div>

    <div class="relative z-10 w-full max-w-4xl flex items-stretch shadow-2xl rounded-2xl overflow-hidden">

        <!-- LEFT: Branding panel -->
        <div class="hidden lg:flex flex-col justify-between w-5/12 bg-gradient-to-br from-brand-900 via-brand-800 to-indigo-700 p-8 relative overflow-hidden">
            <div class="absolute -bottom-20 -left-20 w-72 h-72 rounded-full bg-sky-400/10 blur-3xl pointer-events-none"></div>
            <div class="absolute top-10 right-0 w-40 h-40 rounded-full bg-indigo-400/10 blur-2xl pointer-events-none"></div>

            <div class="flex items-center gap-3 relative z-10">
                <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-indigo-400 to-sky-400 flex items-center justify-center shadow-lg">
                    <i data-lucide="graduation-cap" class="w-5 h-5 text-white"></i>
                </div>
                <div>
                    <p class="font-display font-bold text-white text-xs tracking-wide">FACULTY</p>
                    <p class="text-sky-400 text-[9px] font-semibold tracking-widest uppercase">Management System</p>
                </div>
            </div>

            <div class="relative z-10 space-y-3">
                <h1 class="font-display text-2xl font-bold text-white leading-snug">
                    One system.<br />Every role.<br /><span class="text-sky-400">Full control.</span>
                </h1>
                <p class="text-indigo-300 text-xs leading-relaxed max-w-xs">
                    Manage faculty workload, track attendance, approve leaves, and generate reports, all from a single dashboard.
                </p>
            </div>

            <div class="stat-strip pt-4 mt-4 grid grid-cols-3 gap-3 relative z-10">
                <div>
                    <p class="font-display text-xl font-bold text-white">@ViewData["TotalFaculty"]</p>
                    <p class="text-indigo-400 text-[10px] font-medium mt-0.5">Faculty Members</p>
                </div>
                <div>
                    <p class="font-display text-xl font-bold text-white">@ViewData["TotalDepartments"]</p>
                    <p class="text-indigo-400 text-[10px] font-medium mt-0.5">Departments</p>
                </div>
                <div>
                    <p class="font-display text-xl font-bold text-sky-400">@ViewData["AvgAttendance"]%</p>
                    <p class="text-indigo-400 text-[10px] font-medium mt-0.5">Avg Attendance</p>
                </div>
            </div>
        </div>

        <!-- RIGHT: Login form -->
        <div class="flex-1 bg-white flex flex-col justify-center px-7 py-6 lg:px-10 fade-up">

            <!-- Mobile logo -->
            <div class="flex lg:hidden items-center gap-3 mb-5">
                <div class="w-8 h-8 rounded-xl bg-gradient-to-br from-indigo-500 to-sky-400 flex items-center justify-center shadow">
                    <i data-lucide="graduation-cap" class="w-4 h-4 text-white"></i>
                </div>
                <div>
                    <p class="font-display font-bold text-brand-950 text-xs">FACULTY</p>
                    <p class="text-sky-500 text-[9px] font-semibold tracking-widest uppercase">Management System</p>
                </div>
            </div>

            <div class="mb-4">
                <h2 class="font-display text-xl font-bold text-brand-950">Welcome back</h2>
                <p class="text-indigo-400 text-xs mt-0.5">Sign in to access your dashboard</p>
            </div>

            @* Show server-side error if login failed *@
            @if (ViewData["Error"] != null)
            {
                <div class="mb-3 flex items-center gap-2 bg-rose-50 border border-rose-200 text-rose-600 text-xs font-medium px-3 py-2 rounded-xl">
                    <i data-lucide="alert-circle" class="w-3.5 h-3.5 shrink-0"></i>
                    @ViewData["Error"]
                </div>
            }

            @* Role selector *@
            <div class="mb-4">
                <p class="text-[10px] font-semibold text-indigo-400 uppercase tracking-wider mb-2">Sign in as</p>
                <div class="grid grid-cols-3 gap-2">
                    <button type="button" onclick="selectRole('Admin')" id="role-Admin"
                            class="role-badge selected flex flex-col items-center gap-1 py-2 px-2 rounded-xl">
                        <i data-lucide="shield-check" class="w-4 h-4 text-indigo-500"></i>
                        <span class="text-xs font-semibold text-brand-800">Admin</span>
                        <div class="role-dot"></div>
                    </button>
                    <button type="button" onclick="selectRole('HOD')" id="role-HOD"
                            class="role-badge flex flex-col items-center gap-1 py-2 px-2 rounded-xl">
                        <i data-lucide="building-2" class="w-4 h-4 text-indigo-400"></i>
                        <span class="text-xs font-semibold text-brand-800">HOD</span>
                        <div class="role-dot"></div>
                    </button>
                    <button type="button" onclick="selectRole('Faculty')" id="role-Faculty"
                            class="role-badge flex flex-col items-center gap-1 py-2 px-2 rounded-xl">
                        <i data-lucide="user" class="w-4 h-4 text-indigo-400"></i>
                        <span class="text-xs font-semibold text-brand-800">Faculty</span>
                        <div class="role-dot"></div>
                    </button>
                </div>
            </div>

            @* Form *@
            <form method="post" asp-controller="Account" asp-action="Login" class="space-y-3">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Role" id="selected-role" value="Admin" />

                <!-- Username -->
                <div class="space-y-1">
                    <label class="text-[10px] font-semibold text-brand-800 uppercase tracking-wider">Username</label>
                    <div class="relative">
                        <span class="absolute left-3 top-1/2 -translate-y-1/2 text-indigo-400 pointer-events-none">
                            <i data-lucide="user" class="w-3.5 h-3.5"></i>
                        </span>
                        <input type="text" name="Username" value="@(ViewData["Username"] as string)"
                               placeholder="Enter your username"
                               class="input-field w-full bg-indigo-50/50 text-brand-900 text-sm pl-9 pr-4 py-2.5 rounded-xl placeholder-indigo-300 font-medium"
                               required autocomplete="username" />
                    </div>
                </div>

                <!-- Password -->
                <div class="space-y-1">
                    <label class="text-[10px] font-semibold text-brand-800 uppercase tracking-wider">Password</label>
                    <div class="relative">
                        <span class="absolute left-3 top-1/2 -translate-y-1/2 text-indigo-400 pointer-events-none">
                            <i data-lucide="lock" class="w-3.5 h-3.5"></i>
                        </span>
                        <input type="password" name="Password" id="pw-input"
                               placeholder="Enter your password"
                               class="input-field w-full bg-indigo-50/50 text-brand-900 text-sm pl-9 pr-10 py-2.5 rounded-xl placeholder-indigo-300 font-medium"
                               required autocomplete="current-password" />
                        <button type="button" onclick="togglePw()" id="pw-eye"
                                class="absolute right-3 top-1/2 -translate-y-1/2 text-indigo-300 hover:text-indigo-500 transition-colors">
                            <i data-lucide="eye" class="w-3.5 h-3.5"></i>
                        </button>
                    </div>
                </div>

                <!-- Remember me -->
                <div class="flex items-center justify-between">
                    <label class="flex items-center gap-2 cursor-pointer select-none">
                        <div class="relative">
                            <input type="checkbox" name="RememberMe" id="remember" class="sr-only peer" />
                            <div class="w-8 h-4 bg-indigo-100 rounded-full peer-checked:bg-indigo-500 transition-colors duration-200"></div>
                            <div class="absolute top-0.5 left-0.5 w-3 h-3 bg-white rounded-full shadow transition-transform duration-200 peer-checked:translate-x-4"></div>
                        </div>
                        <span class="text-xs font-medium text-indigo-500">Remember me</span>
                    </label>
                </div>

                <!-- Submit -->
                <button type="submit"
                        class="btn-primary w-full py-2.5 rounded-xl text-white font-semibold text-sm flex items-center justify-center gap-2">
                    <i data-lucide="log-in" class="w-4 h-4"></i>
                    Log In
                </button>
            </form>

            <p class="text-center text-[10px] text-indigo-300 mt-4">
                University of Engineering &amp; Technology, Lahore &nbsp;·&nbsp;
                <span class="text-indigo-400 font-medium">Faculty Management System &copy; @DateTime.Now.Year</span>
            </p>
        </div>
    </div>

    <script>
        lucide.createIcons();

        function selectRole(role) {
            ['Admin','HOD','Faculty'].forEach(r => document.getElementById('role-'+r).classList.remove('selected'));
            document.getElementById('role-'+role).classList.add('selected');
            document.getElementById('selected-role').value = role;
            lucide.createIcons();
        }

        let pwVisible = false;
        function togglePw() {
            pwVisible = !pwVisible;
            document.getElementById('pw-input').type = pwVisible ? 'text' : 'password';
            document.getElementById('pw-eye').innerHTML = pwVisible
                ? '<i data-lucide="eye-off" class="w-4 h-4"></i>'
                : '<i data-lucide="eye" class="w-4 h-4"></i>';
            lucide.createIcons();
        }
    </script>
</body>
</html>

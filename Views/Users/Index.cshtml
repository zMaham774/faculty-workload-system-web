@model List<FacultyManagementSystem.Controllers.UserListRow>
@{
    ViewData["Title"] = "Users";
    var currentUserId = Context.Session.GetInt32("UserId");
}

@if (TempData["Success"] != null)
{
    <div id="toast-success" class="fixed top-6 right-6 z-50 flex items-center gap-3 bg-white border border-emerald-200 text-emerald-700 px-4 py-3 rounded-2xl shadow-xl text-sm font-medium">
        <i data-lucide="check-circle" class="w-4 h-4 text-emerald-500 shrink-0"></i>
        @TempData["Success"]
        <button onclick="document.getElementById('toast-success').remove()" class="ml-2 text-emerald-400 hover:text-emerald-600"><i data-lucide="x" class="w-3.5 h-3.5"></i></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div id="toast-error" class="fixed top-6 right-6 z-50 flex items-center gap-3 bg-white border border-rose-200 text-rose-600 px-4 py-3 rounded-2xl shadow-xl text-sm font-medium">
        <i data-lucide="alert-circle" class="w-4 h-4 text-rose-500 shrink-0"></i>
        @TempData["Error"]
        <button onclick="document.getElementById('toast-error').remove()" class="ml-2 text-rose-400 hover:text-rose-600"><i data-lucide="x" class="w-3.5 h-3.5"></i></button>
    </div>
}

<!-- Page header -->
<div class="flex items-center justify-between mb-6">
    <div>
        <p class="text-indigo-400 text-sm font-medium">Manage</p>
        <h2 class="font-display text-2xl font-bold text-brand-950">Users</h2>
    </div>
    <a asp-action="Create"
       class="inline-flex items-center gap-2 bg-gradient-to-r from-indigo-500 to-sky-400 text-white text-sm font-semibold px-4 py-2.5 rounded-xl shadow hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200">
        <i data-lucide="plus" class="w-4 h-4"></i>
        Add User
    </a>
</div>

<!-- Search -->
<form method="get" asp-action="Index" class="flex items-center gap-2 mb-5">
    <div class="relative flex-1 min-w-64">
        <span class="absolute left-3 top-1/2 -translate-y-1/2 text-indigo-400 pointer-events-none">
            <i data-lucide="search" class="w-4 h-4"></i>
        </span>
        <input type="text" name="search" value="@ViewData["Search"]"
               placeholder="Search by username, role, or faculty name..."
               class="w-full bg-white border border-indigo-100 text-brand-900 text-sm pl-9 pr-4 py-2.5 rounded-xl placeholder-indigo-300 focus:outline-none focus:border-indigo-400 focus:ring-2 focus:ring-indigo-100 transition-all" />
    </div>
    <button type="submit" class="bg-indigo-50 border border-indigo-100 text-indigo-600 text-sm font-semibold px-4 py-2.5 rounded-xl hover:bg-indigo-100 transition-colors">
        Search
    </button>
    @if (ViewData["Search"] != null)
    {
        <a asp-action="Index" class="text-xs font-medium text-indigo-400 hover:text-indigo-600">Clear</a>
    }
</form>

<!-- Stats -->
<div class="flex items-center gap-3 mb-4 flex-wrap">
    <div class="bg-white border border-indigo-100 rounded-xl px-4 py-2 flex items-center gap-2">
        <i data-lucide="user-cog" class="w-4 h-4 text-indigo-500"></i>
        <span class="text-sm font-semibold text-brand-900">@Model.Count</span>
        <span class="text-xs text-indigo-400">Total</span>
    </div>
    <div class="bg-white border border-indigo-100 rounded-xl px-4 py-2 flex items-center gap-2">
        <i data-lucide="shield-check" class="w-4 h-4 text-violet-500"></i>
        <span class="text-sm font-semibold text-brand-900">@Model.Count(u => u.Role == "Admin")</span>
        <span class="text-xs text-indigo-400">Admins</span>
    </div>
    <div class="bg-white border border-indigo-100 rounded-xl px-4 py-2 flex items-center gap-2">
        <i data-lucide="building-2" class="w-4 h-4 text-sky-500"></i>
        <span class="text-sm font-semibold text-brand-900">@Model.Count(u => u.Role == "HOD")</span>
        <span class="text-xs text-indigo-400">HODs</span>
    </div>
    <div class="bg-white border border-indigo-100 rounded-xl px-4 py-2 flex items-center gap-2">
        <i data-lucide="check-circle" class="w-4 h-4 text-emerald-500"></i>
        <span class="text-sm font-semibold text-brand-900">@Model.Count(u => u.IsActive == true)</span>
        <span class="text-xs text-indigo-400">Active</span>
    </div>
</div>

<!-- Table -->
<div class="card overflow-hidden">
    @if (!Model.Any())
    {
        <div class="flex flex-col items-center justify-center py-16 text-center">
            <div class="w-14 h-14 rounded-2xl bg-indigo-50 flex items-center justify-center mb-4">
                <i data-lucide="user-cog" class="w-7 h-7 text-indigo-300"></i>
            </div>
            <p class="font-display font-semibold text-brand-900 text-base">No users found</p>
            <p class="text-indigo-400 text-sm mt-1">Try adjusting your search or add a new user.</p>
        </div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="border-b border-indigo-50 bg-indigo-50/50">
                        <th class="text-left px-5 py-3 text-xs font-semibold text-indigo-400 uppercase tracking-wider">#</th>
                        <th class="text-left px-5 py-3 text-xs font-semibold text-indigo-400 uppercase tracking-wider">Username</th>
                        <th class="text-left px-5 py-3 text-xs font-semibold text-indigo-400 uppercase tracking-wider">Role</th>
                        <th class="text-left px-5 py-3 text-xs font-semibold text-indigo-400 uppercase tracking-wider">Linked Faculty</th>
                        <th class="text-left px-5 py-3 text-xs font-semibold text-indigo-400 uppercase tracking-wider">Last Login</th>
                        <th class="text-left px-5 py-3 text-xs font-semibold text-indigo-400 uppercase tracking-wider">Status</th>
                        <th class="text-left px-5 py-3 text-xs font-semibold text-indigo-400 uppercase tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-indigo-50">
                    @{
                        int i = 1;
                    }
                    @foreach (var u in Model)
                    {
                        bool isSelf = currentUserId == u.UserId;
                        <tr class="hover:bg-indigo-50/30 transition-colors @(isSelf ? "bg-sky-50/20" : "")">
                            <td class="px-5 py-3.5 text-indigo-300 font-medium">@i</td>
                            <td class="px-5 py-3.5">
                                <div class="flex items-center gap-3">
                                    <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-indigo-500 to-sky-400 flex items-center justify-center text-white text-xs font-bold shrink-0">
                                        @u.Username[0].ToString().ToUpper()
                                    </div>
                                    <div>
                                        <p class="font-semibold text-brand-900">@u.Username</p>
                                        @if (isSelf)
                                        {
                                            <p class="text-[10px] font-semibold text-sky-500 uppercase tracking-wider">You</p>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td class="px-5 py-3.5">
                                @{
                                    var roleCls = u.Role switch
                                    {
                                        "Admin" => "bg-violet-50 text-violet-600",
                                        "HOD" => "bg-sky-50 text-sky-600",
                                        _ => "bg-indigo-50 text-indigo-600"
                                    };
                                }
                                <span class="text-xs font-semibold px-2.5 py-1 rounded-full @roleCls">@u.Role</span>
                            </td>
                            <td class="px-5 py-3.5 text-brand-700">@(u.FacultyName ?? "—")</td>
                            <td class="px-5 py-3.5 text-indigo-500">
                                @(u.LastLogin.HasValue? u.LastLogin.Value.ToString("MMM dd, yyyy h:mm tt") : "Never")
                            </td>
                            <td class="px-5 py-3.5">
                                @if (u.IsActive == true)
                                {
                                    <span class="inline-flex items-center gap-1 bg-emerald-50 text-emerald-600 text-xs font-semibold px-2.5 py-1 rounded-full">
                                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Active
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1 bg-rose-50 text-rose-500 text-xs font-semibold px-2.5 py-1 rounded-full">
                                        <span class="w-1.5 h-1.5 rounded-full bg-rose-400"></span> Inactive
                                    </span>
                                }
                            </td>
                            <td class="px-5 py-3.5">
                                <div class="flex items-center gap-2">
                                    <a asp-action="Edit" asp-route-id="@u.UserId"
                                       class="w-8 h-8 rounded-lg bg-indigo-50 flex items-center justify-center text-indigo-500 hover:bg-indigo-100 transition-colors" title="Edit">
                                        <i data-lucide="pencil" class="w-3.5 h-3.5"></i>
                                    </a>
                                    @if (!isSelf)
                                    {
                                        <button onclick="confirmDelete(@u.UserId, '@u.Username')"
                                                class="w-8 h-8 rounded-lg bg-rose-50 flex items-center justify-center text-rose-400 hover:bg-rose-100 transition-colors" title="Delete">
                                            <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="w-8 h-8 rounded-lg bg-indigo-50/50 flex items-center justify-center text-indigo-200 cursor-not-allowed" title="You cannot delete your own account">
                                            <i data-lucide="lock" class="w-3.5 h-3.5"></i>
                                        </span>
                                    }
                                </div>
                            </td>
                        </tr>
                        i++;
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Delete modal -->
<div id="delete-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
    <div class="absolute inset-0 bg-brand-950/40 backdrop-blur-sm" onclick="closeModal()"></div>
    <div class="relative bg-white rounded-2xl shadow-2xl p-6 w-full max-w-sm">
        <div class="w-12 h-12 rounded-2xl bg-rose-50 flex items-center justify-center mx-auto mb-4">
            <i data-lucide="trash-2" class="w-6 h-6 text-rose-500"></i>
        </div>
        <h3 class="font-display font-bold text-brand-950 text-lg text-center">Delete User?</h3>
        <p class="text-indigo-400 text-sm text-center mt-1 mb-5">
            Are you sure you want to permanently delete <span id="delete-name" class="font-semibold text-brand-900"></span>? This cannot be undone.
        </p>
        <form method="post" asp-action="Delete">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="delete-id" />
            <div class="flex gap-3">
                <button type="button" onclick="closeModal()"
                        class="flex-1 py-2.5 rounded-xl border border-indigo-100 text-brand-700 text-sm font-semibold hover:bg-indigo-50 transition-colors">
                    Cancel
                </button>
                <button type="submit"
                        class="flex-1 py-2.5 rounded-xl bg-rose-500 text-white text-sm font-semibold hover:bg-rose-600 transition-colors">
                    Delete
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        lucide.createIcons();
        setTimeout(() => {
            document.getElementById('toast-success')?.remove();
            document.getElementById('toast-error')?.remove();
        }, 4000);
        function confirmDelete(id, name) {
            document.getElementById('delete-id').value = id;
            document.getElementById('delete-name').textContent = name;
            document.getElementById('delete-modal').classList.remove('hidden');
        }
        function closeModal() {
            document.getElementById('delete-modal').classList.add('hidden');
        }
    </script>
}

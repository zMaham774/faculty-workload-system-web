@model FacultyManagementSystem.Models.Department
@{
    ViewData["Title"] = "Departments";
}

<div class="max-w-2xl mx-auto">

    <!-- Breadcrumb -->
    <div class="flex items-center gap-2 text-xs text-indigo-400 font-medium mb-6">
        <a asp-action="Index" class="hover:text-indigo-600 transition-colors">Departments</a>
        <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
        <span class="text-brand-700">Edit</span>
    </div>

    <!-- Header -->
    <div class="mb-6">
        <h2 class="font-display text-2xl font-bold text-brand-950">Edit Department</h2>
        <p class="text-indigo-400 text-sm mt-1">Update the details for <span class="font-semibold text-brand-700">@Model.DeptName</span>.</p>
    </div>

    <!-- Form card -->
    <div class="card p-6">
        <form method="post" asp-action="Edit" asp-route-id="@Model.DeptId" class="space-y-5">
            @Html.AntiForgeryToken()

            <!-- Department Name -->
            <div class="space-y-1.5">
                <label class="text-xs font-semibold text-brand-800 uppercase tracking-wider">
                    Department Name <span class="text-rose-400">*</span>
                </label>
                <input asp-for="DeptName" placeholder="e.g. Computer Science"
                       class="w-full bg-indigo-50/50 border border-indigo-100 text-brand-900 text-sm px-4 py-2.5 rounded-xl placeholder-indigo-300 focus:outline-none focus:border-indigo-400 focus:ring-2 focus:ring-indigo-100 transition-all" />
                @if (ViewData.ModelState["DeptName"]?.Errors.Count > 0)
                {
                    <p class="text-xs text-rose-500 font-medium">@ViewData.ModelState["DeptName"]!.Errors[0].ErrorMessage</p>
                }
            </div>

            <!-- HOD Name -->
            <div class="space-y-1.5">
                <label class="text-xs font-semibold text-brand-800 uppercase tracking-wider">HOD Name</label>
                <div class="relative">
                    <span class="absolute left-3 top-1/2 -translate-y-1/2 text-indigo-400 pointer-events-none">
                        <i data-lucide="user" class="w-3.5 h-3.5"></i>
                    </span>
                    <select name="HodName"
                            class="w-full bg-indigo-50/50 border border-indigo-100 text-brand-900 text-sm pl-9 pr-4 py-2.5 rounded-xl focus:outline-none focus:border-indigo-400 focus:ring-2 focus:ring-indigo-100 transition-all appearance-none">
                        <option value="">— Select HOD —</option>
                        @foreach (var name in (List<string>)ViewBag.FacultyList)
                        {
                            @if (ViewBag.SelectedHod == name)
                            {
                                <option value="@name" selected>@name</option>
                            }
                            else
                            {
                                <option value="@name">@name</option>
                            }
                        }
                    </select>
                    <span class="absolute right-3 top-1/2 -translate-y-1/2 text-indigo-400 pointer-events-none">
                        <i data-lucide="chevron-down" class="w-3.5 h-3.5"></i>
                    </span>
                </div>
            </div>

            <!-- Contact + Email -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="space-y-1.5">
                    <label class="text-xs font-semibold text-brand-800 uppercase tracking-wider">Contact</label>
                    <div class="relative">
                        <span class="absolute left-3 top-1/2 -translate-y-1/2 text-indigo-400 pointer-events-none">
                            <i data-lucide="phone" class="w-3.5 h-3.5"></i>
                        </span>
                        <input asp-for="Contact" placeholder="e.g. 042-1234567"
                               class="w-full bg-indigo-50/50 border border-indigo-100 text-brand-900 text-sm pl-9 pr-4 py-2.5 rounded-xl placeholder-indigo-300 focus:outline-none focus:border-indigo-400 focus:ring-2 focus:ring-indigo-100 transition-all" />
                    </div>
                </div>
                <div class="space-y-1.5">
                    <label class="text-xs font-semibold text-brand-800 uppercase tracking-wider">Email</label>
                    <div class="relative">
                        <span class="absolute left-3 top-1/2 -translate-y-1/2 text-indigo-400 pointer-events-none">
                            <i data-lucide="mail" class="w-3.5 h-3.5"></i>
                        </span>
                        <input asp-for="Email" type="email" placeholder="e.g. cs@uet.edu.pk"
                               class="w-full bg-indigo-50/50 border border-indigo-100 text-brand-900 text-sm pl-9 pr-4 py-2.5 rounded-xl placeholder-indigo-300 focus:outline-none focus:border-indigo-400 focus:ring-2 focus:ring-indigo-100 transition-all" />
                    </div>
                </div>
            </div>

            <!-- Status toggle -->
            <div class="flex items-center justify-between p-4 bg-indigo-50/50 border border-indigo-100 rounded-xl">
                <div>
                    <p class="text-sm font-semibold text-brand-900">Active Status</p>
                    <p class="text-xs text-indigo-400 mt-0.5">Inactive departments won't appear in assignments</p>
                </div>
                <label class="relative cursor-pointer">
                    <input type="checkbox" name="IsActive" value="true" class="sr-only peer"
                           @(Model.IsActive == true ? "checked" : "") />
                    <input type="hidden" name="IsActive" value="false" />
                    <div class="w-11 h-6 bg-indigo-200 rounded-full peer-checked:bg-indigo-500 transition-colors duration-200"></div>
                    <div class="absolute top-0.5 left-0.5 w-5 h-5 bg-white rounded-full shadow transition-transform duration-200 peer-checked:translate-x-5"></div>
                </label>
            </div>

            <!-- Info strip -->
            <div class="flex items-center gap-2 bg-sky-50 border border-sky-100 px-4 py-3 rounded-xl">
                <i data-lucide="info" class="w-4 h-4 text-sky-400 shrink-0"></i>
                <p class="text-xs text-sky-600 font-medium">
                    Changes are saved immediately on submit.
                </p>
            </div>

            <!-- Actions -->
            <div class="flex items-center gap-3 pt-2">
                <button type="submit"
                        class="flex-1 bg-gradient-to-r from-indigo-500 to-sky-400 text-white text-sm font-semibold py-2.5 rounded-xl hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200 flex items-center justify-center gap-2">
                    <i data-lucide="save" class="w-4 h-4"></i>
                    Save Changes
                </button>
                <a asp-action="Index"
                   class="flex-1 text-center bg-indigo-50 border border-indigo-100 text-brand-700 text-sm font-semibold py-2.5 rounded-xl hover:bg-indigo-100 transition-colors">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>lucide.createIcons();</script>
}

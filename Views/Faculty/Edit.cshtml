@model FacultyManagementSystem.Models.Faculty
@{
    ViewData["Title"] = "Faculty";
}

<div class="max-w-2xl mx-auto">

    <div class="flex items-center gap-2 text-xs text-indigo-400 font-medium mb-6">
        <a asp-action="Index" class="hover:text-indigo-600 transition-colors">Faculty</a>
        <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
        <span class="text-brand-700">Edit</span>
    </div>

    <div class="mb-6">
        <h2 class="font-display text-2xl font-bold text-brand-950">Edit Faculty</h2>
        <p class="text-indigo-400 text-sm mt-1">Update details for <span class="font-semibold text-brand-700">@Model.Name</span>.</p>
    </div>

    <div class="card p-6">
        <form method="post" asp-action="Edit" asp-route-id="@Model.EmpId" class="space-y-5">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="bg-rose-50 border border-rose-200 p-3 rounded-xl mb-4 text-xs text-rose-600">
                    @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <p>@err.ErrorMessage</p>
                    }
                </div>
            }
            @Html.AntiForgeryToken()

            <!-- Name -->
            <div class="space-y-1.5">
                <label class="text-xs font-semibold text-brand-800 uppercase tracking-wider">
                    Full Name <span class="text-rose-400">*</span>
                </label>
                <input asp-for="Name" placeholder="e.g. Dr. Sara Ahmed"
                       class="w-full bg-indigo-50/50 border border-indigo-100 text-brand-900 text-sm px-4 py-2.5 rounded-xl placeholder-indigo-300 focus:outline-none focus:border-indigo-400 focus:ring-2 focus:ring-indigo-100 transition-all" />
                @if (ViewData.ModelState["Name"]?.Errors.Count > 0)
                {
                    <p class="text-xs text-rose-500 font-medium">@ViewData.ModelState["Name"]!.Errors[0].ErrorMessage</p>
                }
                <div class="flex items-center gap-1.5 mt-1">
                    <i data-lucide="info" class="w-3 h-3 text-sky-400"></i>
                    <p class="text-[10px] text-sky-500">If this faculty is a department HOD, renaming here auto-updates the department record too.</p>
                </div>
            </div>

            <!-- Department + Designation -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="space-y-1.5">
                    <label class="text-xs font-semibold text-brand-800 uppercase tracking-wider">
                        Department <span class="text-rose-400">*</span>
                    </label>
                    <select asp-for="DeptId"
                            class="w-full bg-indigo-50/50 border border-indigo-100 text-brand-900 text-sm px-4 py-2.5 rounded-xl focus:outline-none focus:border-indigo-400 appearance-none">
                        @foreach (var dept in (dynamic)ViewBag.Departments)
                        {
                            @if (Model.DeptId == dept.DeptId)
                            {
                                <option value="@dept.DeptId" selected>@dept.DeptName</option>
                            }
                            else
                            {
                                <option value="@dept.DeptId">@dept.DeptName</option>
                            }
                        }
                    </select>
                </div>

                <div class="space-y-1.5">
                    <div class="flex items-center justify-between">
                        <label class="text-xs font-semibold text-brand-800 uppercase tracking-wider">
                            Designation <span class="text-rose-400">*</span>
                        </label>
                        <button type="button" onclick="openDesigModal()"
                                class="text-[11px] font-semibold text-indigo-500 hover:text-indigo-700 flex items-center gap-1">
                            <i data-lucide="plus-circle" class="w-3 h-3"></i> Add New
                        </button>
                    </div>
                    <select asp-for="DesignationId" id="designation-select"
                            class="w-full bg-indigo-50/50 border border-indigo-100 text-brand-900 text-sm px-4 py-2.5 rounded-xl focus:outline-none focus:border-indigo-400 appearance-none">
                        @foreach (var desig in (dynamic)ViewBag.Designations)
                        {
                            @if (Model.DesignationId == desig.DesignationId)
                            {
                                <option value="@desig.DesignationId" selected>@desig.DesignationName</option>
                            }
                            else
                            {
                                <option value="@desig.DesignationId">@desig.DesignationName</option>
                            }
                        }
                    </select>
                </div>
            </div>

            <!-- Employee Type -->
            <div class="space-y-1.5">
                <label class="text-xs font-semibold text-brand-800 uppercase tracking-wider">
                    Employee Type <span class="text-rose-400">*</span>
                </label>
                <div class="grid grid-cols-3 gap-2">
                    @foreach (var type in (List<string>)ViewBag.EmpTypes)
                    {
                        var isChecked = string.Equals(Model.EmpType?.Trim(), type.Trim(), StringComparison.OrdinalIgnoreCase);
                        <label class="relative cursor-pointer">
                            <input type="radio" name="EmpType" value="@type" class="sr-only peer"
                                   @(isChecked ? "checked" : "") />
                            <div class="text-center py-2.5 rounded-xl border border-indigo-100 text-sm font-semibold text-brand-700 peer-checked:bg-indigo-500 peer-checked:text-white peer-checked:border-indigo-500 transition-all">
                                @type
                            </div>
                        </label>
                    }
                </div>
            </div>

            <!-- Qualification -->
            <div class="space-y-1.5">
                <label class="text-xs font-semibold text-brand-800 uppercase tracking-wider">Qualification</label>
                <input asp-for="Qualification" placeholder="e.g. PhD Computer Science"
                       class="w-full bg-indigo-50/50 border border-indigo-100 text-brand-900 text-sm px-4 py-2.5 rounded-xl placeholder-indigo-300 focus:outline-none focus:border-indigo-400 focus:ring-2 focus:ring-indigo-100 transition-all" />
            </div>

            <!-- Email + Phone -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="space-y-1.5">
                    <label class="text-xs font-semibold text-brand-800 uppercase tracking-wider">Email</label>
                    <div class="relative">
                        <span class="absolute left-3 top-1/2 -translate-y-1/2 text-indigo-400 pointer-events-none"><i data-lucide="mail" class="w-3.5 h-3.5"></i></span>
                        <input asp-for="Email" type="email"
                               class="w-full bg-indigo-50/50 border border-indigo-100 text-brand-900 text-sm pl-9 pr-4 py-2.5 rounded-xl focus:outline-none focus:border-indigo-400 focus:ring-2 focus:ring-indigo-100 transition-all" />
                    </div>
                </div>
                <div class="space-y-1.5">
                    <label class="text-xs font-semibold text-brand-800 uppercase tracking-wider">Phone</label>
                    <div class="relative">
                        <span class="absolute left-3 top-1/2 -translate-y-1/2 text-indigo-400 pointer-events-none"><i data-lucide="phone" class="w-3.5 h-3.5"></i></span>
                        <input asp-for="Phone"
                               class="w-full bg-indigo-50/50 border border-indigo-100 text-brand-900 text-sm pl-9 pr-4 py-2.5 rounded-xl focus:outline-none focus:border-indigo-400 focus:ring-2 focus:ring-indigo-100 transition-all" />
                    </div>
                </div>
            </div>

            <!-- Status toggle -->
            <div class="flex items-center justify-between p-4 bg-indigo-50/50 border border-indigo-100 rounded-xl">
                <div>
                    <p class="text-sm font-semibold text-brand-900">Active Status</p>
                    <p class="text-xs text-indigo-400 mt-0.5">Inactive faculty won't appear in assignments</p>
                </div>
                <label class="relative cursor-pointer">
                    <input type="checkbox" name="IsActive" value="true" class="sr-only peer"
                           @(Model.IsActive == true ? "checked" : "") />
                    <input type="hidden" name="IsActive" value="false" />
                    <div class="w-11 h-6 bg-indigo-200 rounded-full peer-checked:bg-indigo-500 transition-colors duration-200"></div>
                    <div class="absolute top-0.5 left-0.5 w-5 h-5 bg-white rounded-full shadow transition-transform duration-200 peer-checked:translate-x-5"></div>
                </label>
            </div>

            <!-- Actions -->
            <div class="flex items-center gap-3 pt-2">
                <button type="submit"
                        class="flex-1 bg-gradient-to-r from-indigo-500 to-sky-400 text-white text-sm font-semibold py-2.5 rounded-xl hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200 flex items-center justify-center gap-2">
                    <i data-lucide="save" class="w-4 h-4"></i> Save Changes
                </button>
                <a asp-action="Index"
                   class="flex-1 text-center bg-indigo-50 border border-indigo-100 text-brand-700 text-sm font-semibold py-2.5 rounded-xl hover:bg-indigo-100 transition-colors">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Add Designation Modal (same as Create) -->
<div id="desig-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
    <div class="absolute inset-0 bg-brand-950/40 backdrop-blur-sm" onclick="closeDesigModal()"></div>
    <div class="relative bg-white rounded-2xl shadow-2xl p-6 w-full max-w-sm">
        <div class="w-12 h-12 rounded-2xl bg-indigo-50 flex items-center justify-center mx-auto mb-4">
            <i data-lucide="award" class="w-6 h-6 text-indigo-500"></i>
        </div>
        <h3 class="font-display font-bold text-brand-950 text-lg text-center">Add Designation</h3>
        <p class="text-indigo-400 text-sm text-center mt-1 mb-5">Create a new designation to assign to faculty.</p>

        <div id="desig-error" class="hidden mb-3 flex items-center gap-2 bg-rose-50 border border-rose-200 text-rose-600 text-xs font-medium px-3 py-2 rounded-xl">
            <i data-lucide="alert-circle" class="w-3.5 h-3.5 shrink-0"></i>
            <span id="desig-error-text"></span>
        </div>

        <div class="space-y-3">
            <div class="space-y-1">
                <label class="text-[10px] font-semibold text-brand-800 uppercase tracking-wider">Designation Name</label>
                <input type="text" id="new-desig-name" placeholder="e.g. Assistant Professor"
                       class="w-full bg-indigo-50/50 border border-indigo-100 text-brand-900 text-sm px-4 py-2.5 rounded-xl placeholder-indigo-300 focus:outline-none focus:border-indigo-400 focus:ring-2 focus:ring-indigo-100 transition-all" />
            </div>
            <div class="space-y-1">
                <label class="text-[10px] font-semibold text-brand-800 uppercase tracking-wider">Rank Order</label>
                <input type="number" id="new-desig-rank" min="1" placeholder="e.g. 3"
                       class="w-full bg-indigo-50/50 border border-indigo-100 text-brand-900 text-sm px-4 py-2.5 rounded-xl placeholder-indigo-300 focus:outline-none focus:border-indigo-400 focus:ring-2 focus:ring-indigo-100 transition-all" />
                <p class="text-[10px] text-indigo-400">Lower number = higher rank (e.g. Professor = 1)</p>
            </div>
        </div>

        <div class="flex gap-3 mt-5">
            <button type="button" onclick="closeDesigModal()"
                    class="flex-1 py-2.5 rounded-xl border border-indigo-100 text-brand-700 text-sm font-semibold hover:bg-indigo-50 transition-colors">
                Cancel
            </button>
            <button type="button" onclick="submitDesignation()"
                    class="flex-1 py-2.5 rounded-xl bg-indigo-500 text-white text-sm font-semibold hover:bg-indigo-600 transition-colors">
                Add
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        lucide.createIcons();

        function openDesigModal() {
            document.getElementById('desig-modal').classList.remove('hidden');
            document.getElementById('desig-error').classList.add('hidden');
        }
        function closeDesigModal() {
            document.getElementById('desig-modal').classList.add('hidden');
            document.getElementById('new-desig-name').value = '';
            document.getElementById('new-desig-rank').value = '';
        }

        async function submitDesignation() {
            const name = document.getElementById('new-desig-name').value.trim();
            const rank = document.getElementById('new-desig-rank').value || 1;
            const errorBox  = document.getElementById('desig-error');
            const errorText = document.getElementById('desig-error-text');

            if (!name) {
                errorText.textContent = 'Designation name is required.';
                errorBox.classList.remove('hidden');
                return;
            }

            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            const formData = new FormData();
            formData.append('designationName', name);
            formData.append('rankOrder', rank);
            formData.append('__RequestVerificationToken', token);

            try {
                const res = await fetch('@Url.Action("AddDesignation", "Faculty")', {
                    method: 'POST',
                    body: formData
                });
                const data = await res.json();

                if (data.success) {
                    const select = document.getElementById('designation-select');
                    const opt = document.createElement('option');
                    opt.value = data.designationId;
                    opt.textContent = data.designationName;
                    opt.selected = true;
                    select.appendChild(opt);
                    closeDesigModal();
                } else {
                    errorText.textContent = data.message || 'Failed to add designation.';
                    errorBox.classList.remove('hidden');
                }
            } catch (err) {
                errorText.textContent = 'Something went wrong. Please try again.';
                errorBox.classList.remove('hidden');
            }
        }
    </script>
}

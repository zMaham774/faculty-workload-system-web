@model List<FacultyManagementSystem.Controllers.WorkloadRow>
@{
    ViewData["Title"] = "Workload";
    bool hodLocked = ViewData["HodLocked"] is bool b && b;
}

@if (TempData["Success"] != null)
{
    <div id="toast-success" class="fixed top-6 right-6 z-50 flex items-center gap-3 bg-white border border-emerald-200 text-emerald-700 px-4 py-3 rounded-2xl shadow-xl text-sm font-medium max-w-md">
        <i data-lucide="check-circle" class="w-4 h-4 text-emerald-500 shrink-0"></i>
        @TempData["Success"]
        <button onclick="document.getElementById('toast-success').remove()" class="ml-2 text-emerald-400 hover:text-emerald-600"><i data-lucide="x" class="w-3.5 h-3.5"></i></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div id="toast-error" class="fixed top-6 right-6 z-50 flex items-center gap-3 bg-white border border-rose-200 text-rose-600 px-4 py-3 rounded-2xl shadow-xl text-sm font-medium max-w-md">
        <i data-lucide="alert-circle" class="w-4 h-4 text-rose-500 shrink-0"></i>
        @TempData["Error"]
        <button onclick="document.getElementById('toast-error').remove()" class="ml-2 text-rose-400 hover:text-rose-600"><i data-lucide="x" class="w-3.5 h-3.5"></i></button>
    </div>
}

<!-- Page header -->
<div class="flex items-center justify-between mb-6">
    <div>
        <p class="text-indigo-400 text-sm font-medium">Manage</p>
        <h2 class="font-display text-2xl font-bold text-brand-950">Workload Assignments</h2>
        @if (hodLocked)
        {
            <p class="text-xs text-sky-500 font-medium mt-1 flex items-center gap-1">
                <i data-lucide="lock" class="w-3 h-3"></i> Showing your department only
            </p>
        }
    </div>
    <div class="flex items-center gap-2">
        <button onclick="openStandardsModal()"
                class="inline-flex items-center gap-2 bg-white border border-indigo-100 text-indigo-600 text-sm font-semibold px-4 py-2.5 rounded-xl hover:bg-indigo-50 transition-colors">
            <i data-lucide="sliders-horizontal" class="w-4 h-4"></i>
            Manage Standards
        </button>
        <a asp-action="Create"
           class="inline-flex items-center gap-2 bg-gradient-to-r from-indigo-500 to-sky-400 text-white text-sm font-semibold px-4 py-2.5 rounded-xl shadow hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200">
            <i data-lucide="plus" class="w-4 h-4"></i>
            Add Assignment
        </a>
    </div>
</div>

<!-- Filters -->
<form method="get" asp-action="Index" class="card p-4 mb-5">
    <div class="flex flex-wrap gap-3">
        <div class="relative min-w-48">
            <select name="semId" onchange="this.form.submit()"
                    class="w-full bg-indigo-50/50 border border-indigo-100 text-brand-900 text-sm px-3 py-2.5 rounded-xl focus:outline-none focus:border-indigo-400 appearance-none">
                @foreach (var sem in (dynamic)ViewBag.Semesters)
                {
                    @if (ViewData["SelectedSem"] != null && (int)ViewData["SelectedSem"]! == sem.SemId)
                    {
                        <option value="@sem.SemId" selected>@sem.SemName</option>
                    }
                    else
                    {
                        <option value="@sem.SemId">@sem.SemName</option>
                    }
                }
            </select>
            <span class="absolute right-3 top-1/2 -translate-y-1/2 text-indigo-400 pointer-events-none">
                <i data-lucide="chevron-down" class="w-3.5 h-3.5"></i>
            </span>
        </div>

        @if (!hodLocked)
        {
            <div class="relative min-w-48">
                <select name="deptId" onchange="this.form.submit()"
                        class="w-full bg-indigo-50/50 border border-indigo-100 text-brand-900 text-sm px-3 py-2.5 rounded-xl focus:outline-none focus:border-indigo-400 appearance-none">
                    <option value="">All Departments</option>
                    @foreach (var dept in (dynamic)ViewBag.Departments)
                    {
                        @if (ViewData["SelectedDept"] != null && (int)ViewData["SelectedDept"]! == dept.DeptId)
                        {
                            <option value="@dept.DeptId" selected>@dept.DeptName</option>
                        }
                        else
                        {
                            <option value="@dept.DeptId">@dept.DeptName</option>
                        }
                    }
                </select>
                <span class="absolute right-3 top-1/2 -translate-y-1/2 text-indigo-400 pointer-events-none">
                    <i data-lucide="chevron-down" class="w-3.5 h-3.5"></i>
                </span>
            </div>
        }
    </div>
</form>

<!-- Stats -->
<div class="flex items-center gap-3 mb-4 flex-wrap">
    <div class="bg-white border border-indigo-100 rounded-xl px-4 py-2 flex items-center gap-2">
        <i data-lucide="briefcase" class="w-4 h-4 text-indigo-500"></i>
        <span class="text-sm font-semibold text-brand-900">@Model.Count</span>
        <span class="text-xs text-indigo-400">Assignments</span>
    </div>
    <div class="bg-white border border-indigo-100 rounded-xl px-4 py-2 flex items-center gap-2">
        <i data-lucide="users" class="w-4 h-4 text-sky-500"></i>
        <span class="text-sm font-semibold text-brand-900">@Model.Select(w => w.EmpId).Distinct().Count()</span>
        <span class="text-xs text-indigo-400">Faculty</span>
    </div>
    <div class="bg-white border border-indigo-100 rounded-xl px-4 py-2 flex items-center gap-2">
        <i data-lucide="hash" class="w-4 h-4 text-violet-500"></i>
        <span class="text-sm font-semibold text-brand-900">@Model.Sum(w => w.TotalHours)</span>
        <span class="text-xs text-indigo-400">Total Hours</span>
    </div>
</div>

<!-- Table -->
<div class="card overflow-hidden">
    @if (!Model.Any())
    {
        <div class="flex flex-col items-center justify-center py-16 text-center">
            <div class="w-14 h-14 rounded-2xl bg-indigo-50 flex items-center justify-center mb-4">
                <i data-lucide="briefcase" class="w-7 h-7 text-indigo-300"></i>
            </div>
            <p class="font-display font-semibold text-brand-900 text-base">No workload assignments found</p>
            <p class="text-indigo-400 text-sm mt-1">Try a different semester or add a new assignment.</p>
            <a asp-action="Create" class="mt-4 inline-flex items-center gap-2 bg-indigo-500 text-white text-sm font-semibold px-4 py-2 rounded-xl hover:bg-indigo-600 transition-colors">
                <i data-lucide="plus" class="w-4 h-4"></i> Add Assignment
            </a>
        </div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="border-b border-indigo-50 bg-indigo-50/50">
                        <th class="text-left px-5 py-3 text-xs font-semibold text-indigo-400 uppercase tracking-wider">#</th>
                        <th class="text-left px-5 py-3 text-xs font-semibold text-indigo-400 uppercase tracking-wider">Faculty</th>
                        <th class="text-left px-5 py-3 text-xs font-semibold text-indigo-400 uppercase tracking-wider">Course</th>
                        <th class="text-left px-5 py-3 text-xs font-semibold text-indigo-400 uppercase tracking-wider">Department</th>
                        <th class="text-left px-5 py-3 text-xs font-semibold text-indigo-400 uppercase tracking-wider">Semester</th>
                        <th class="text-left px-5 py-3 text-xs font-semibold text-indigo-400 uppercase tracking-wider">Hours</th>
                        <th class="text-left px-5 py-3 text-xs font-semibold text-indigo-400 uppercase tracking-wider">Status</th>
                        <th class="text-left px-5 py-3 text-xs font-semibold text-indigo-400 uppercase tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-indigo-50">
                    @{
                        int i = 1;
                    }
                    @foreach (var w in Model)
                    {
                        var initials = string.Join("", w.FacultyName.Split(' ').Take(2).Select(x => char.ToUpper(x[0])));
                        <tr class="hover:bg-indigo-50/30 transition-colors">
                            <td class="px-5 py-3.5 text-indigo-300 font-medium">@i</td>
                            <td class="px-5 py-3.5">
                                <div class="flex items-center gap-2">
                                    <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-indigo-500 to-sky-400 flex items-center justify-center text-white text-xs font-bold shrink-0">
                                        @initials
                                    </div>
                                    <span class="font-semibold text-brand-900">@w.FacultyName</span>
                                </div>
                            </td>
                            <td class="px-5 py-3.5">
                                <p class="font-medium text-brand-800">@w.CourseCode</p>
                                <p class="text-xs text-indigo-400">@w.CourseTitle</p>
                            </td>
                            <td class="px-5 py-3.5 text-brand-700">@w.DeptName</td>
                            <td class="px-5 py-3.5 text-brand-700">@w.SemName</td>
                            <td class="px-5 py-3.5">
                                <span class="inline-flex items-center gap-1 bg-sky-50 text-sky-600 text-xs font-semibold px-2.5 py-1 rounded-full">@w.TotalHours hrs</span>
                            </td>
                            <td class="px-5 py-3.5">
                                @{
                                    var statusCls = w.Status switch
                                    {
                                        "Active" => "bg-emerald-50 text-emerald-600",
                                        "Substituted" => "bg-amber-50 text-amber-600",
                                        _ => "bg-rose-50 text-rose-500"
                                    };
                                    var dotCls = w.Status switch
                                    {
                                        "Active" => "bg-emerald-500",
                                        "Substituted" => "bg-amber-400",
                                        _ => "bg-rose-400"
                                    };
                                }
                                <span class="inline-flex items-center gap-1 @statusCls text-xs font-semibold px-2.5 py-1 rounded-full">
                                    <span class="w-1.5 h-1.5 rounded-full @dotCls"></span> @w.Status
                                </span>
                            </td>
                            <td class="px-5 py-3.5">
                                <div class="flex items-center gap-2">
                                    <button onclick='openReassignModal(@w.WaId, @Html.Raw(System.Text.Json.JsonSerializer.Serialize(w.FacultyName)), @w.DeptId, @w.CourseId, @w.SemId)'
                                            class="w-8 h-8 rounded-lg bg-violet-50 flex items-center justify-center text-violet-500 hover:bg-violet-100 transition-colors" title="Reassign">
                                        <i data-lucide="repeat" class="w-3.5 h-3.5"></i>
                                    </button>
                                    <a asp-action="Edit" asp-route-id="@w.WaId"
                                       class="w-8 h-8 rounded-lg bg-indigo-50 flex items-center justify-center text-indigo-500 hover:bg-indigo-100 transition-colors" title="Edit">
                                        <i data-lucide="pencil" class="w-3.5 h-3.5"></i>
                                    </a>
                                    <button onclick="confirmDelete(@w.WaId, '@w.FacultyName — @w.CourseCode')"
                                            class="w-8 h-8 rounded-lg bg-rose-50 flex items-center justify-center text-rose-400 hover:bg-rose-100 transition-colors" title="Delete">
                                        <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                        i++;
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Delete modal -->
<div id="delete-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
    <div class="absolute inset-0 bg-brand-950/40 backdrop-blur-sm" onclick="closeModal('delete-modal')"></div>
    <div class="relative bg-white rounded-2xl shadow-2xl p-6 w-full max-w-sm">
        <div class="w-12 h-12 rounded-2xl bg-rose-50 flex items-center justify-center mx-auto mb-4">
            <i data-lucide="trash-2" class="w-6 h-6 text-rose-500"></i>
        </div>
        <h3 class="font-display font-bold text-brand-950 text-lg text-center">Delete Assignment?</h3>
        <p class="text-indigo-400 text-sm text-center mt-1 mb-5">
            Remove <span id="delete-name" class="font-semibold text-brand-900"></span> from workload?
        </p>
        <form method="post" asp-action="Delete">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="delete-id" />
            <div class="flex gap-3">
                <button type="button" onclick="closeModal('delete-modal')"
                        class="flex-1 py-2.5 rounded-xl border border-indigo-100 text-brand-700 text-sm font-semibold hover:bg-indigo-50 transition-colors">
                    Cancel
                </button>
                <button type="submit"
                        class="flex-1 py-2.5 rounded-xl bg-rose-500 text-white text-sm font-semibold hover:bg-rose-600 transition-colors">
                    Delete
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Reassign modal -->
<div id="reassign-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
    <div class="absolute inset-0 bg-brand-950/40 backdrop-blur-sm" onclick="closeModal('reassign-modal')"></div>
    <div class="relative bg-white rounded-2xl shadow-2xl p-6 w-full max-w-md">
        <div class="w-12 h-12 rounded-2xl bg-violet-50 flex items-center justify-center mx-auto mb-4">
            <i data-lucide="repeat" class="w-6 h-6 text-violet-500"></i>
        </div>
        <h3 class="font-display font-bold text-brand-950 text-lg text-center">Reassign Course</h3>
        <p class="text-indigo-400 text-sm text-center mt-1 mb-5">
            Currently assigned to <span id="reassign-current-name" class="font-semibold text-brand-900"></span>
        </p>

        <div id="reassign-error" class="hidden mb-3 flex items-center gap-2 bg-rose-50 border border-rose-200 text-rose-600 text-xs font-medium px-3 py-2 rounded-xl">
            <i data-lucide="alert-circle" class="w-3.5 h-3.5 shrink-0"></i>
            <span id="reassign-error-text"></span>
        </div>

        <div class="space-y-3">
            <div class="space-y-1">
                <label class="text-[10px] font-semibold text-brand-800 uppercase tracking-wider">Reassign To</label>
                <select id="reassign-to-faculty"
                        class="w-full bg-indigo-50/50 border border-indigo-100 text-brand-900 text-sm px-4 py-2.5 rounded-xl focus:outline-none focus:border-indigo-400 appearance-none">
                    <option value="">— Select faculty member —</option>
                </select>
            </div>
            <div class="space-y-1">
                <label class="text-[10px] font-semibold text-brand-800 uppercase tracking-wider">Reason (optional)</label>
                <textarea id="reassign-reason" rows="2" placeholder="e.g. Faculty on leave, overload correction..."
                          class="w-full bg-indigo-50/50 border border-indigo-100 text-brand-900 text-sm px-4 py-2.5 rounded-xl placeholder-indigo-300 focus:outline-none focus:border-indigo-400 focus:ring-2 focus:ring-indigo-100 transition-all resize-none"></textarea>
            </div>
        </div>

        <div class="flex gap-3 mt-5">
            <button type="button" onclick="closeModal('reassign-modal')"
                    class="flex-1 py-2.5 rounded-xl border border-indigo-100 text-brand-700 text-sm font-semibold hover:bg-indigo-50 transition-colors">
                Cancel
            </button>
            <button type="button" onclick="submitReassign()"
                    class="flex-1 py-2.5 rounded-xl bg-violet-500 text-white text-sm font-semibold hover:bg-violet-600 transition-colors">
                Reassign
            </button>
        </div>
    </div>
</div>

<!-- Standards modal -->
<div id="standards-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
    <div class="absolute inset-0 bg-brand-950/40 backdrop-blur-sm" onclick="closeModal('standards-modal')"></div>
    <div class="relative bg-white rounded-2xl shadow-2xl p-6 w-full max-w-2xl max-h-[85vh] overflow-y-auto">
        <div class="flex items-center justify-between mb-4">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-2xl bg-indigo-50 flex items-center justify-center">
                    <i data-lucide="sliders-horizontal" class="w-5 h-5 text-indigo-500"></i>
                </div>
                <div>
                    <h3 class="font-display font-bold text-brand-950 text-lg">Workload Standards</h3>
                    <p class="text-xs text-indigo-400">Credit hour thresholds per department per semester</p>
                </div>
            </div>
            <button onclick="closeModal('standards-modal')" class="w-8 h-8 rounded-lg bg-indigo-50 flex items-center justify-center text-indigo-400 hover:bg-indigo-100">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </div>

        <div id="standards-error" class="hidden mb-3 flex items-center gap-2 bg-rose-50 border border-rose-200 text-rose-600 text-xs font-medium px-3 py-2 rounded-xl">
            <i data-lucide="alert-circle" class="w-3.5 h-3.5 shrink-0"></i>
            <span id="standards-error-text"></span>
        </div>

        <!-- Add/Edit form -->
        <div class="bg-indigo-50/50 border border-indigo-100 rounded-xl p-4 mb-4">
            <input type="hidden" id="std-ws-id" value="0" />
            <div class="grid grid-cols-2 gap-3 mb-3">
                <div class="space-y-1">
                    <label class="text-[10px] font-semibold text-brand-800 uppercase tracking-wider">Department</label>
                    <select id="std-dept"
                            class="w-full bg-white border border-indigo-100 text-brand-900 text-sm px-3 py-2 rounded-lg focus:outline-none focus:border-indigo-400 appearance-none">
                        @foreach (var dept in (dynamic)ViewBag.Departments)
                        {
                            <option value="@dept.DeptId">@dept.DeptName</option>
                        }
                    </select>
                </div>
                <div class="space-y-1">
                    <label class="text-[10px] font-semibold text-brand-800 uppercase tracking-wider">Semester</label>
                    <select id="std-sem"
                            class="w-full bg-white border border-indigo-100 text-brand-900 text-sm px-3 py-2 rounded-lg focus:outline-none focus:border-indigo-400 appearance-none">
                        @foreach (var sem in (dynamic)ViewBag.Semesters)
                        {
                            <option value="@sem.SemId">@sem.SemName</option>
                        }
                    </select>
                </div>
            </div>
            <div class="grid grid-cols-3 gap-3 mb-3">
                <div class="space-y-1">
                    <label class="text-[10px] font-semibold text-brand-800 uppercase tracking-wider">Min Hours</label>
                    <input type="number" id="std-min" min="1" class="w-full bg-white border border-indigo-100 text-brand-900 text-sm px-3 py-2 rounded-lg focus:outline-none focus:border-indigo-400" />
                </div>
                <div class="space-y-1">
                    <label class="text-[10px] font-semibold text-brand-800 uppercase tracking-wider">Standard Hours</label>
                    <input type="number" id="std-std" min="1" class="w-full bg-white border border-indigo-100 text-brand-900 text-sm px-3 py-2 rounded-lg focus:outline-none focus:border-indigo-400" />
                </div>
                <div class="space-y-1">
                    <label class="text-[10px] font-semibold text-brand-800 uppercase tracking-wider">Max Hours</label>
                    <input type="number" id="std-max" min="1" class="w-full bg-white border border-indigo-100 text-brand-900 text-sm px-3 py-2 rounded-lg focus:outline-none focus:border-indigo-400" />
                </div>
            </div>
            <div class="flex gap-2">
                <button onclick="saveStandard()" id="std-save-btn"
                        class="flex-1 py-2 rounded-lg bg-indigo-500 text-white text-sm font-semibold hover:bg-indigo-600 transition-colors">
                    Add Standard
                </button>
                <button onclick="resetStandardForm()" id="std-cancel-btn"
                        class="hidden px-4 py-2 rounded-lg border border-indigo-100 text-brand-700 text-sm font-semibold hover:bg-indigo-50 transition-colors">
                    Cancel
                </button>
            </div>
        </div>

        <!-- Existing standards list -->
        <div id="standards-list" class="space-y-2">
            <p class="text-sm text-indigo-300 text-center py-4">Loading...</p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        lucide.createIcons();
        setTimeout(() => {
            document.getElementById('toast-success')?.remove();
            document.getElementById('toast-error')?.remove();
        }, 5000);

        function closeModal(id) { document.getElementById(id).classList.add('hidden'); }

        // ── Delete ──
        function confirmDelete(id, name) {
            document.getElementById('delete-id').value = id;
            document.getElementById('delete-name').textContent = name;
            document.getElementById('delete-modal').classList.remove('hidden');
        }

        // ── Reassign ──
        const facultyByDept = {};
        @foreach (var f in (dynamic)ViewBag.FacultyList)
        {
                @: facultyByDept[@f.DeptId] = facultyByDept[@f.DeptId] || [];
                @: facultyByDept[@f.DeptId].push({ id: @f.EmpId, name: @Html.Raw(System.Text.Json.JsonSerializer.Serialize((string)f.Name)) });
        }

        let currentReassignWaId = null;

        function openReassignModal(waId, currentName, deptId, courseId, semId) {
            currentReassignWaId = waId;
            document.getElementById('reassign-current-name').textContent = currentName;
            document.getElementById('reassign-error').classList.add('hidden');
            document.getElementById('reassign-reason').value = '';

            const select = document.getElementById('reassign-to-faculty');
            select.innerHTML = '<option value="">— Select faculty member —</option>';
            (facultyByDept[deptId] || []).forEach(f => {
                const opt = document.createElement('option');
                opt.value = f.id;
                opt.textContent = f.name;
                select.appendChild(opt);
            });

            document.getElementById('reassign-modal').classList.remove('hidden');
        }

        function submitReassign() {
            const toEmpId = document.getElementById('reassign-to-faculty').value;
            const reason  = document.getElementById('reassign-reason').value;
            const errorBox  = document.getElementById('reassign-error');
            const errorText = document.getElementById('reassign-error-text');

            if (!toEmpId) {
                errorText.textContent = 'Please select a faculty member.';
                errorBox.classList.remove('hidden');
                return;
            }

            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = '@Url.Action("Reassign", "Workload")';

            const fields = {
                waId: currentReassignWaId,
                toEmpId: toEmpId,
                reason: reason,
                __RequestVerificationToken: token
            };
            for (const key in fields) {
                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = key;
                input.value = fields[key];
                form.appendChild(input);
            }
            document.body.appendChild(form);
            form.submit();
        }

        // ── Standards ──
        function openStandardsModal() {
            document.getElementById('standards-modal').classList.remove('hidden');
            resetStandardForm();
            loadStandards();
        }

        async function loadStandards() {
            const list = document.getElementById('standards-list');
            list.innerHTML = '<p class="text-sm text-indigo-300 text-center py-4">Loading...</p>';

            try {
                const res = await fetch('@Url.Action("Standards", "Workload")');
                const data = await res.json();

                if (!data.length) {
                    list.innerHTML = '<p class="text-sm text-indigo-300 text-center py-4">No standards defined yet.</p>';
                    return;
                }

                list.innerHTML = '';
                data.forEach(s => {
                    const row = document.createElement('div');
                    row.className = 'flex items-center justify-between p-3 rounded-xl bg-indigo-50/50 border border-indigo-100';
                    row.innerHTML = `
                        <div>
                            <p class="text-sm font-semibold text-brand-900">${s.deptName} — ${s.semName}</p>
                            <p class="text-xs text-indigo-400">Min: ${s.minHours} · Standard: ${s.stdHours} · Max: ${s.maxHours}</p>
                        </div>
                        <div class="flex items-center gap-2">
                            <button onclick='editStandard(${JSON.stringify(s)})' class="w-8 h-8 rounded-lg bg-indigo-100 flex items-center justify-center text-indigo-500 hover:bg-indigo-200 transition-colors">
                                <i data-lucide="pencil" class="w-3.5 h-3.5"></i>
                            </button>
                            <button onclick="deleteStandard(${s.wsId})" class="w-8 h-8 rounded-lg bg-rose-50 flex items-center justify-center text-rose-400 hover:bg-rose-100 transition-colors">
                                <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                            </button>
                        </div>`;
                    list.appendChild(row);
                });
                lucide.createIcons();
            } catch (err) {
                list.innerHTML = '<p class="text-sm text-rose-400 text-center py-4">Failed to load standards.</p>';
            }
        }

        function editStandard(s) {
            document.getElementById('std-ws-id').value = s.wsId;
            document.getElementById('std-dept').value = s.deptId;
            document.getElementById('std-sem').value = s.semId;
            document.getElementById('std-min').value = s.minHours;
            document.getElementById('std-std').value = s.stdHours;
            document.getElementById('std-max').value = s.maxHours;
            document.getElementById('std-save-btn').textContent = 'Update Standard';
            document.getElementById('std-cancel-btn').classList.remove('hidden');
        }

        function resetStandardForm() {
            document.getElementById('std-ws-id').value = 0;
            document.getElementById('std-min').value = '';
            document.getElementById('std-std').value = '';
            document.getElementById('std-max').value = '';
            document.getElementById('std-save-btn').textContent = 'Add Standard';
            document.getElementById('std-cancel-btn').classList.add('hidden');
            document.getElementById('standards-error').classList.add('hidden');
        }

        async function saveStandard() {
            const errorBox  = document.getElementById('standards-error');
            const errorText = document.getElementById('standards-error-text');
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            const formData = new FormData();
            formData.append('wsId', document.getElementById('std-ws-id').value);
            formData.append('deptId', document.getElementById('std-dept').value);
            formData.append('semId', document.getElementById('std-sem').value);
            formData.append('minHours', document.getElementById('std-min').value);
            formData.append('maxHours', document.getElementById('std-max').value);
            formData.append('stdHours', document.getElementById('std-std').value);
            formData.append('__RequestVerificationToken', token);

            try {
                const res = await fetch('@Url.Action("SaveStandard", "Workload")', { method: 'POST', body: formData });
                const data = await res.json();
                if (data.success) {
                    resetStandardForm();
                    loadStandards();
                } else {
                    errorText.textContent = data.message || 'Failed to save standard.';
                    errorBox.classList.remove('hidden');
                }
            } catch (err) {
                errorText.textContent = 'Something went wrong. Please try again.';
                errorBox.classList.remove('hidden');
            }
        }

        async function deleteStandard(wsId) {
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            const formData = new FormData();
            formData.append('wsId', wsId);
            formData.append('__RequestVerificationToken', token);

            try {
                const res = await fetch('@Url.Action("DeleteStandard", "Workload")', { method: 'POST', body: formData });
                const data = await res.json();
                if (data.success) {
                    loadStandards();
                }
            } catch (err) { /* silent */ }
        }
    </script>
}

<!-- Hidden anti-forgery token for AJAX calls -->
<form style="display:none">@Html.AntiForgeryToken()</form>

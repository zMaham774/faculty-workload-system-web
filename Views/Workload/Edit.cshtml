@model FacultyManagementSystem.Models.WorkloadAssignment
@{
    ViewData["Title"] = "Workload";
    var facultyName = ((dynamic)ViewBag.FacultyList as IEnumerable<dynamic>)?
        .FirstOrDefault(f => f.EmpId == Model.EmpId)?.Name ?? "—";
    var courseInfo = ((dynamic)ViewBag.CourseList as IEnumerable<dynamic>)?
        .FirstOrDefault(c => c.CourseId == Model.CourseId);
    var semInfo = ((dynamic)ViewBag.Semesters as IEnumerable<dynamic>)?
        .FirstOrDefault(s => s.SemId == Model.SemId);
}

<div class="max-w-2xl mx-auto">

    <div class="flex items-center gap-2 text-xs text-indigo-400 font-medium mb-6">
        <a asp-action="Index" class="hover:text-indigo-600 transition-colors">Workload</a>
        <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
        <span class="text-brand-700">Edit</span>
    </div>

    <div class="mb-6">
        <h2 class="font-display text-2xl font-bold text-brand-950">Edit Workload Assignment</h2>
        <p class="text-indigo-400 text-sm mt-1">You can update hours, status, and date. To change faculty use <span class="font-semibold text-brand-700">Reassign</span> instead.</p>
    </div>

    @if (ViewData.ModelState["TotalHours"]?.Errors.Count > 0)
    {
        <div class="mb-4 flex items-center gap-2 bg-rose-50 border border-rose-200 text-rose-600 text-sm font-medium px-4 py-3 rounded-xl">
            <i data-lucide="alert-triangle" class="w-4 h-4 shrink-0"></i>
            @ViewData.ModelState["TotalHours"]!.Errors[0].ErrorMessage
        </div>
    }

    <div class="card p-6">
        <form method="post" asp-action="Edit" asp-route-id="@Model.WaId" class="space-y-5">
            @Html.AntiForgeryToken()

            <!-- Locked info block -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 p-4 bg-indigo-50/50 border border-indigo-100 rounded-xl">
                <div>
                    <p class="text-[10px] font-semibold text-indigo-400 uppercase tracking-wider">Faculty</p>
                    <p class="text-sm font-semibold text-brand-900 flex items-center gap-1">
                        <i data-lucide="lock" class="w-3 h-3 text-indigo-300"></i> @facultyName
                    </p>
                </div>
                <div>
                    <p class="text-[10px] font-semibold text-indigo-400 uppercase tracking-wider">Course</p>
                    <p class="text-sm font-semibold text-brand-900">@(courseInfo?.CourseCode ?? "—")</p>
                </div>
                <div>
                    <p class="text-[10px] font-semibold text-indigo-400 uppercase tracking-wider">Semester</p>
                    <p class="text-sm font-semibold text-brand-900">@(semInfo?.SemName ?? "—")</p>
                </div>
            </div>

            <!-- Total Hours -->
            <div class="space-y-1.5">
                <label class="text-xs font-semibold text-brand-800 uppercase tracking-wider">
                    Total Hours <span class="text-rose-400">*</span>
                </label>
                <input asp-for="TotalHours" type="number" step="0.5" min="0.5"
                       class="w-full bg-indigo-50/50 border border-indigo-100 text-brand-900 text-sm px-4 py-2.5 rounded-xl focus:outline-none focus:border-indigo-400 focus:ring-2 focus:ring-indigo-100 transition-all" />
            </div>

            <!-- Status -->
            <div class="space-y-1.5">
                <label class="text-xs font-semibold text-brand-800 uppercase tracking-wider">Status</label>
                <div class="grid grid-cols-3 gap-2">
                    @foreach (var status in (List<string>)ViewBag.StatusOptions)
                    {
                        <label class="relative cursor-pointer">
                            <input type="radio" name="Status" value="@status" class="sr-only peer"
                                   @(Model.Status == status ? "checked" : "") />
                            <div class="text-center py-2.5 rounded-xl border border-indigo-100 text-xs font-semibold text-brand-700 peer-checked:bg-indigo-500 peer-checked:text-white peer-checked:border-indigo-500 transition-all">
                                @status
                            </div>
                        </label>
                    }
                </div>
            </div>

            <!-- Assigned Date -->
            <div class="space-y-1.5">
                <label class="text-xs font-semibold text-brand-800 uppercase tracking-wider">Assigned Date</label>
                <input asp-for="AssignedDate" type="date"
                       class="w-full bg-indigo-50/50 border border-indigo-100 text-brand-900 text-sm px-4 py-2.5 rounded-xl focus:outline-none focus:border-indigo-400 focus:ring-2 focus:ring-indigo-100 transition-all" />
            </div>

            <!-- Actions -->
            <div class="flex items-center gap-3 pt-2">
                <button type="submit"
                        class="flex-1 bg-gradient-to-r from-indigo-500 to-sky-400 text-white text-sm font-semibold py-2.5 rounded-xl hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200 flex items-center justify-center gap-2">
                    <i data-lucide="save" class="w-4 h-4"></i> Save Changes
                </button>
                <a asp-action="Index"
                   class="flex-1 text-center bg-indigo-50 border border-indigo-100 text-brand-700 text-sm font-semibold py-2.5 rounded-xl hover:bg-indigo-100 transition-colors">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>lucide.createIcons();</script>
}

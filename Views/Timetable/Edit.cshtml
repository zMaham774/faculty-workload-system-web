@model FacultyManagementSystem.Models.Timetable
@{
    ViewData["Title"] = "Timetable";
    var days = (List<string>)ViewBag.Days;
    var assignInfo = ((dynamic)ViewBag.AssignmentList as IEnumerable<dynamic>)?
        .FirstOrDefault(a => a.WaId == Model.WaId);
}

<div class="max-w-2xl mx-auto">

    <div class="flex items-center gap-2 text-xs text-indigo-400 font-medium mb-6">
        <a asp-action="Index" class="hover:text-indigo-600 transition-colors">Timetable</a>
        <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
        <span class="text-brand-700">Edit</span>
    </div>

    <div class="mb-6">
        <h2 class="font-display text-2xl font-bold text-brand-950">Edit Class</h2>
        <p class="text-indigo-400 text-sm mt-1">Update the day, time slot, or room for this class.</p>
    </div>

    @if (ViewData.ModelState["SlotId"]?.Errors.Count > 0)
    {
        <div class="mb-4 flex items-center gap-2 bg-rose-50 border border-rose-200 text-rose-600 text-sm font-medium px-4 py-3 rounded-xl">
            <i data-lucide="alert-triangle" class="w-4 h-4 shrink-0"></i>
            @ViewData.ModelState["SlotId"]!.Errors[0].ErrorMessage
        </div>
    }

    <div class="card p-6">
        <form method="post" asp-action="Edit" asp-route-id="@Model.TtId" class="space-y-5">
            @Html.AntiForgeryToken()

            <!-- Locked assignment info -->
            <div class="p-4 bg-indigo-50/50 border border-indigo-100 rounded-xl">
                <p class="text-[10px] font-semibold text-indigo-400 uppercase tracking-wider">Workload Assignment</p>
                <p class="text-sm font-semibold text-brand-900 flex items-center gap-1 mt-0.5">
                    <i data-lucide="lock" class="w-3 h-3 text-indigo-300"></i> @(assignInfo?.Display ?? "—")
                </p>
                <p class="text-[10px] text-indigo-400 mt-1">To change the assignment, delete this class and create a new one.</p>
            </div>

            <!-- Day -->
            <div class="space-y-1.5">
                <label class="text-xs font-semibold text-brand-800 uppercase tracking-wider">
                    Day of Week <span class="text-rose-400">*</span>
                </label>
                <div class="grid grid-cols-3 sm:grid-cols-6 gap-2">
                    @foreach (var d in days)
                    {
                        <label class="relative cursor-pointer">
                            <input type="radio" name="DayOfWeek" value="@d" class="sr-only peer"
                                   @(Model.DayOfWeek == d ? "checked" : "") />
                            <div class="text-center py-2 rounded-xl border border-indigo-100 text-xs font-semibold text-brand-700 peer-checked:bg-indigo-500 peer-checked:text-white peer-checked:border-indigo-500 transition-all">
                                @d.Substring(0, 3)
                            </div>
                        </label>
                    }
                </div>
            </div>

            <!-- Time Slot -->
            <div class="space-y-1.5">
                <label class="text-xs font-semibold text-brand-800 uppercase tracking-wider">
                    Time Slot <span class="text-rose-400">*</span>
                </label>
                <select asp-for="SlotId"
                        class="w-full bg-indigo-50/50 border border-indigo-100 text-brand-900 text-sm px-4 py-2.5 rounded-xl focus:outline-none focus:border-indigo-400 appearance-none">
                    @foreach (var s in (dynamic)ViewBag.TimeSlots)
                    {
                        @if (Model.SlotId == s.SlotId)
                        {
                            <option value="@s.SlotId" selected>@s.SlotLabel</option>
                        }
                        else
                        {
                            <option value="@s.SlotId">@s.SlotLabel</option>
                        }
                    }
                </select>
            </div>

            <!-- Room -->
            <div class="space-y-1.5">
                <label class="text-xs font-semibold text-brand-800 uppercase tracking-wider">Room</label>
                <div class="relative">
                    <span class="absolute left-3 top-1/2 -translate-y-1/2 text-indigo-400 pointer-events-none"><i data-lucide="map-pin" class="w-3.5 h-3.5"></i></span>
                    <input asp-for="Room" placeholder="e.g. Room 204"
                           class="w-full bg-indigo-50/50 border border-indigo-100 text-brand-900 text-sm pl-9 pr-4 py-2.5 rounded-xl placeholder-indigo-300 focus:outline-none focus:border-indigo-400 focus:ring-2 focus:ring-indigo-100 transition-all" />
                </div>
            </div>

            @if (Model.ConflictFlag)
            {
                <div class="flex items-center gap-2 bg-rose-50 border border-rose-200 px-4 py-3 rounded-xl">
                    <i data-lucide="alert-triangle" class="w-4 h-4 text-rose-500 shrink-0"></i>
                    <p class="text-xs text-rose-600 font-medium">This class currently conflicts with another booking for the same room/slot/day.</p>
                </div>
            }

            <!-- Actions -->
            <div class="flex items-center gap-3 pt-2">
                <button type="submit"
                        class="flex-1 bg-gradient-to-r from-indigo-500 to-sky-400 text-white text-sm font-semibold py-2.5 rounded-xl hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200 flex items-center justify-center gap-2">
                    <i data-lucide="save" class="w-4 h-4"></i> Save Changes
                </button>
                <a asp-action="Index"
                   class="flex-1 text-center bg-indigo-50 border border-indigo-100 text-brand-700 text-sm font-semibold py-2.5 rounded-xl hover:bg-indigo-100 transition-colors">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>lucide.createIcons();</script>
}

@model List<FacultyManagementSystem.Controllers.TimetableRow>
@{
    ViewData["Title"] = "Timetable";
    bool readOnly = ViewData["ReadOnly"] is bool ro && ro;
    bool hodLocked = ViewData["HodLocked"] is bool hl && hl;
    var days = (List<string>)ViewBag.Days;
}

@if (TempData["Success"] != null)
{
    <div id="toast-success" class="fixed top-6 right-6 z-50 flex items-center gap-3 bg-white border border-emerald-200 text-emerald-700 px-4 py-3 rounded-2xl shadow-xl text-sm font-medium max-w-md">
        <i data-lucide="check-circle" class="w-4 h-4 text-emerald-500 shrink-0"></i>
        @TempData["Success"]
        <button onclick="document.getElementById('toast-success').remove()" class="ml-2 text-emerald-400 hover:text-emerald-600"><i data-lucide="x" class="w-3.5 h-3.5"></i></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div id="toast-error" class="fixed top-6 right-6 z-50 flex items-center gap-3 bg-white border border-rose-200 text-rose-600 px-4 py-3 rounded-2xl shadow-xl text-sm font-medium max-w-md">
        <i data-lucide="alert-circle" class="w-4 h-4 text-rose-500 shrink-0"></i>
        @TempData["Error"]
        <button onclick="document.getElementById('toast-error').remove()" class="ml-2 text-rose-400 hover:text-rose-600"><i data-lucide="x" class="w-3.5 h-3.5"></i></button>
    </div>
}

<!-- Page header -->
<div class="flex items-center justify-between mb-6">
    <div>
        <p class="text-indigo-400 text-sm font-medium">@(readOnly ? "My" : "Manage")</p>
        <h2 class="font-display text-2xl font-bold text-brand-950">Timetable</h2>
        @if (hodLocked)
        {
            <p class="text-xs text-sky-500 font-medium mt-1 flex items-center gap-1">
                <i data-lucide="lock" class="w-3 h-3"></i> Showing your department only
            </p>
        }
    </div>
    @if (!readOnly)
    {
        <a asp-action="Create"
           class="inline-flex items-center gap-2 bg-gradient-to-r from-indigo-500 to-sky-400 text-white text-sm font-semibold px-4 py-2.5 rounded-xl shadow hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200">
            <i data-lucide="plus" class="w-4 h-4"></i>
            Add Class
        </a>
    }
</div>

@if (!readOnly)
{
    <!-- Filters -->
    <form method="get" asp-action="Index" class="card p-4 mb-5">
        <div class="flex flex-wrap gap-3">
            <div class="relative min-w-48">
                <select name="semId" onchange="this.form.submit()"
                        class="w-full bg-indigo-50/50 border border-indigo-100 text-brand-900 text-sm px-3 py-2.5 rounded-xl focus:outline-none focus:border-indigo-400 appearance-none">
                    <option value="">All Semesters</option>
                    @foreach (var sem in (dynamic)ViewBag.Semesters)
                    {
                        @if (ViewData["SelectedSem"] != null && (int)ViewData["SelectedSem"]! == sem.SemId)
                        {
                            <option value="@sem.SemId" selected>@sem.SemName</option>
                        }
                        else
                        {
                            <option value="@sem.SemId">@sem.SemName</option>
                        }
                    }
                </select>
                <span class="absolute right-3 top-1/2 -translate-y-1/2 text-indigo-400 pointer-events-none">
                    <i data-lucide="chevron-down" class="w-3.5 h-3.5"></i>
                </span>
            </div>
            <div class="relative min-w-40">
                <select name="day" onchange="this.form.submit()"
                        class="w-full bg-indigo-50/50 border border-indigo-100 text-brand-900 text-sm px-3 py-2.5 rounded-xl focus:outline-none focus:border-indigo-400 appearance-none">
                    <option value="">All Days</option>
                    @foreach (var d in days)
                    {
                        @if (ViewData["SelectedDay"] as string == d)
                        {
                            <option value="@d" selected>@d</option>
                        }
                        else
                        {
                            <option value="@d">@d</option>
                        }
                    }
                </select>
                <span class="absolute right-3 top-1/2 -translate-y-1/2 text-indigo-400 pointer-events-none">
                    <i data-lucide="chevron-down" class="w-3.5 h-3.5"></i>
                </span>
            </div>
        </div>
    </form>
}

<!-- Stats -->
<div class="flex items-center gap-3 mb-4 flex-wrap">
    <div class="bg-white border border-indigo-100 rounded-xl px-4 py-2 flex items-center gap-2">
        <i data-lucide="calendar-days" class="w-4 h-4 text-indigo-500"></i>
        <span class="text-sm font-semibold text-brand-900">@Model.Count</span>
        <span class="text-xs text-indigo-400">Classes</span>
    </div>
    @if (Model.Any(t => t.ConflictFlag))
    {
        <div class="bg-white border border-rose-100 rounded-xl px-4 py-2 flex items-center gap-2">
            <i data-lucide="alert-triangle" class="w-4 h-4 text-rose-500"></i>
            <span class="text-sm font-semibold text-brand-900">@Model.Count(t => t.ConflictFlag)</span>
            <span class="text-xs text-rose-400">Conflicts</span>
        </div>
    }
</div>

<!-- Weekly grid grouped by day -->
@if (!Model.Any())
{
    <div class="card flex flex-col items-center justify-center py-16 text-center">
        <div class="w-14 h-14 rounded-2xl bg-indigo-50 flex items-center justify-center mb-4">
            <i data-lucide="calendar-days" class="w-7 h-7 text-indigo-300"></i>
        </div>
        <p class="font-display font-semibold text-brand-900 text-base">No classes scheduled</p>
        <p class="text-indigo-400 text-sm mt-1">
            @(readOnly ? "You have no classes scheduled yet." : "Try a different filter or add a new class.")
        </p>
    </div>
}
else
{
    <div class="space-y-4">
        @foreach (var day in days)
        {
            var dayClasses = Model.Where(t => t.DayOfWeek == day).OrderBy(t => t.StartTime).ToList();
            if (!dayClasses.Any()) continue;

            <div class="card overflow-hidden">
                <div class="px-5 py-3 bg-indigo-50/50 border-b border-indigo-100 flex items-center gap-2">
                    <i data-lucide="calendar" class="w-4 h-4 text-indigo-500"></i>
                    <h3 class="font-display font-semibold text-brand-900 text-sm">@day</h3>
                    <span class="text-xs text-indigo-400">(@dayClasses.Count class@(dayClasses.Count != 1 ? "es" : ""))</span>
                </div>
                <div class="divide-y divide-indigo-50">
                    @foreach (var t in dayClasses)
                    {
                        <div class="px-5 py-3.5 flex items-center justify-between hover:bg-indigo-50/20 transition-colors">
                            <div class="flex items-center gap-4 flex-1">
                                <div class="w-20 shrink-0">
                                    <p class="text-xs font-semibold text-indigo-500">@t.SlotLabel</p>
                                    <p class="text-[10px] text-indigo-300">@t.StartTime.ToString("h:mm tt")</p>
                                </div>
                                <div class="w-9 h-9 rounded-lg bg-gradient-to-br from-indigo-500 to-sky-400 flex items-center justify-center text-white text-xs font-bold shrink-0">
                                    @t.CourseCode.Substring(0, Math.Min(2, t.CourseCode.Length))
                                </div>
                                <div class="flex-1 min-w-0">
                                    <p class="text-sm font-semibold text-brand-900 truncate">@t.CourseTitle</p>
                                    <p class="text-xs text-indigo-400">@t.CourseCode &middot; @t.FacultyName @(!readOnly ? $"· {t.DeptName}" : "")</p>
                                </div>
                                @if (!string.IsNullOrEmpty(t.Room))
                                {
                                    <span class="inline-flex items-center gap-1 bg-sky-50 text-sky-600 text-xs font-semibold px-2.5 py-1 rounded-full shrink-0">
                                        <i data-lucide="map-pin" class="w-3 h-3"></i> @t.Room
                                    </span>
                                }
                                @if (t.ConflictFlag)
                                {
                                    <span class="inline-flex items-center gap-1 bg-rose-50 text-rose-500 text-xs font-semibold px-2.5 py-1 rounded-full shrink-0">
                                        <i data-lucide="alert-triangle" class="w-3 h-3"></i> Conflict
                                    </span>
                                }
                            </div>
                            @if (!readOnly)
                            {
                                <div class="flex items-center gap-2 shrink-0 ml-3">
                                    <a asp-action="Edit" asp-route-id="@t.TtId"
                                       class="w-8 h-8 rounded-lg bg-indigo-50 flex items-center justify-center text-indigo-500 hover:bg-indigo-100 transition-colors" title="Edit">
                                        <i data-lucide="pencil" class="w-3.5 h-3.5"></i>
                                    </a>
                                    <button onclick="confirmDelete(@t.TtId, '@t.CourseCode — @day @t.SlotLabel')"
                                            class="w-8 h-8 rounded-lg bg-rose-50 flex items-center justify-center text-rose-400 hover:bg-rose-100 transition-colors" title="Delete">
                                        <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                                    </button>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}

@if (!readOnly)
{
    <!-- Delete modal -->
    <div id="delete-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
        <div class="absolute inset-0 bg-brand-950/40 backdrop-blur-sm" onclick="closeModal()"></div>
        <div class="relative bg-white rounded-2xl shadow-2xl p-6 w-full max-w-sm">
            <div class="w-12 h-12 rounded-2xl bg-rose-50 flex items-center justify-center mx-auto mb-4">
                <i data-lucide="trash-2" class="w-6 h-6 text-rose-500"></i>
            </div>
            <h3 class="font-display font-bold text-brand-950 text-lg text-center">Remove Class?</h3>
            <p class="text-indigo-400 text-sm text-center mt-1 mb-5">
                Remove <span id="delete-name" class="font-semibold text-brand-900"></span> from the timetable?
            </p>
            <form method="post" asp-action="Delete">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="delete-id" />
                <div class="flex gap-3">
                    <button type="button" onclick="closeModal()"
                            class="flex-1 py-2.5 rounded-xl border border-indigo-100 text-brand-700 text-sm font-semibold hover:bg-indigo-50 transition-colors">
                        Cancel
                    </button>
                    <button type="submit"
                            class="flex-1 py-2.5 rounded-xl bg-rose-500 text-white text-sm font-semibold hover:bg-rose-600 transition-colors">
                        Remove
                    </button>
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
    <script>
        lucide.createIcons();
        setTimeout(() => {
            document.getElementById('toast-success')?.remove();
            document.getElementById('toast-error')?.remove();
        }, 5000);
        function confirmDelete(id, name) {
            document.getElementById('delete-id').value = id;
            document.getElementById('delete-name').textContent = name;
            document.getElementById('delete-modal').classList.remove('hidden');
        }
        function closeModal() {
            document.getElementById('delete-modal')?.classList.add('hidden');
        }
    </script>
}

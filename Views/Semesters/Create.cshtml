@model FacultyManagementSystem.Models.Semester
@{
    ViewData["Title"] = "Semesters";
}

<div class="max-w-2xl mx-auto">

    <!-- Breadcrumb -->
    <div class="flex items-center gap-2 text-xs text-indigo-400 font-medium mb-6">
        <a asp-action="Index" class="hover:text-indigo-600 transition-colors">Semesters</a>
        <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
        <span class="text-brand-700">Add New</span>
    </div>

    <div class="mb-6">
        <h2 class="font-display text-2xl font-bold text-brand-950">Add Semester</h2>
        <p class="text-indigo-400 text-sm mt-1">Create a new academic semester.</p>
    </div>

    <div class="card p-6">
        <form method="post" asp-action="Create" class="space-y-5">
            @Html.AntiForgeryToken()

            <!-- Semester Name -->
            <div class="space-y-1.5">
                <label class="text-xs font-semibold text-brand-800 uppercase tracking-wider">
                    Semester Name <span class="text-rose-400">*</span>
                </label>
                <input asp-for="SemName" placeholder="e.g. Fall 2025"
                       class="w-full bg-indigo-50/50 border border-indigo-100 text-brand-900 text-sm px-4 py-2.5 rounded-xl placeholder-indigo-300 focus:outline-none focus:border-indigo-400 focus:ring-2 focus:ring-indigo-100 transition-all" />
                @if (ViewData.ModelState["SemName"]?.Errors.Count > 0)
                {
                    <p class="text-xs text-rose-500 font-medium">@ViewData.ModelState["SemName"]!.Errors[0].ErrorMessage</p>
                }
            </div>

            <!-- Academic Year -->
            <div class="space-y-1.5">
                <label class="text-xs font-semibold text-brand-800 uppercase tracking-wider">
                    Academic Year <span class="text-rose-400">*</span>
                </label>
                <input asp-for="AcadYear" placeholder="e.g. 2025-2026"
                       class="w-full bg-indigo-50/50 border border-indigo-100 text-brand-900 text-sm px-4 py-2.5 rounded-xl placeholder-indigo-300 focus:outline-none focus:border-indigo-400 focus:ring-2 focus:ring-indigo-100 transition-all" />
                @if (ViewData.ModelState["AcadYear"]?.Errors.Count > 0)
                {
                    <p class="text-xs text-rose-500 font-medium">@ViewData.ModelState["AcadYear"]!.Errors[0].ErrorMessage</p>
                }
            </div>

            <!-- Start + End Date -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="space-y-1.5">
                    <label class="text-xs font-semibold text-brand-800 uppercase tracking-wider">
                        Start Date <span class="text-rose-400">*</span>
                    </label>
                    <div class="relative">
                        <span class="absolute left-3 top-1/2 -translate-y-1/2 text-indigo-400 pointer-events-none">
                            <i data-lucide="calendar" class="w-3.5 h-3.5"></i>
                        </span>
                        <input asp-for="StartDate" type="date"
                               class="w-full bg-indigo-50/50 border border-indigo-100 text-brand-900 text-sm pl-9 pr-4 py-2.5 rounded-xl focus:outline-none focus:border-indigo-400 focus:ring-2 focus:ring-indigo-100 transition-all" />
                    </div>
                </div>
                <div class="space-y-1.5">
                    <label class="text-xs font-semibold text-brand-800 uppercase tracking-wider">
                        End Date <span class="text-rose-400">*</span>
                    </label>
                    <div class="relative">
                        <span class="absolute left-3 top-1/2 -translate-y-1/2 text-indigo-400 pointer-events-none">
                            <i data-lucide="calendar" class="w-3.5 h-3.5"></i>
                        </span>
                        <input asp-for="EndDate" type="date"
                               class="w-full bg-indigo-50/50 border border-indigo-100 text-brand-900 text-sm pl-9 pr-4 py-2.5 rounded-xl focus:outline-none focus:border-indigo-400 focus:ring-2 focus:ring-indigo-100 transition-all" />
                    </div>
                    @if (ViewData.ModelState["EndDate"]?.Errors.Count > 0)
                    {
                        <p class="text-xs text-rose-500 font-medium">@ViewData.ModelState["EndDate"]!.Errors[0].ErrorMessage</p>
                    }
                </div>
            </div>

            <!-- Set as current toggle -->
            <div class="flex items-center justify-between p-4 bg-indigo-50/50 border border-indigo-100 rounded-xl">
                <div>
                    <p class="text-sm font-semibold text-brand-900">Set as Current Semester</p>
                    <p class="text-xs text-indigo-400 mt-0.5">This will deactivate any existing current semester</p>
                </div>
                <label class="relative cursor-pointer">
                    <input type="checkbox" name="IsCurrent" value="true" class="sr-only peer" />
                    <input type="hidden" name="IsCurrent" value="false" />
                    <div class="w-11 h-6 bg-indigo-200 rounded-full peer-checked:bg-indigo-500 transition-colors duration-200"></div>
                    <div class="absolute top-0.5 left-0.5 w-5 h-5 bg-white rounded-full shadow transition-transform duration-200 peer-checked:translate-x-5"></div>
                </label>
            </div>

            <!-- Actions -->
            <div class="flex items-center gap-3 pt-2">
                <button type="submit"
                        class="flex-1 bg-gradient-to-r from-indigo-500 to-sky-400 text-white text-sm font-semibold py-2.5 rounded-xl hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200 flex items-center justify-center gap-2">
                    <i data-lucide="save" class="w-4 h-4"></i>
                    Save Semester
                </button>
                <a asp-action="Index"
                   class="flex-1 text-center bg-indigo-50 border border-indigo-100 text-brand-700 text-sm font-semibold py-2.5 rounded-xl hover:bg-indigo-100 transition-colors">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>lucide.createIcons();</script>
}

@model FacultyManagementSystem.Controllers.AdminDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        Chart.defaults.font.family = 'Inter, system-ui, sans-serif';
        Chart.defaults.color = '#818cf8';
        const INDIGO = '#6366f1', SKY = '#38bdf8';

        // Workload bar chart
        new Chart(document.getElementById('admin-workload-chart'), {
            type: 'bar',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.WorkloadChartLabels)),
                datasets: [{
                    label: 'Avg Credit Hrs',
                    data:  @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.WorkloadChartData)),
                    backgroundColor: ctx => {
                        const g = ctx.chart.ctx.createLinearGradient(0,0,0,200);
                        g.addColorStop(0,'#6366f1'); g.addColorStop(1,'#38bdf8'); return g;
                    },
                    borderRadius: 8, borderSkipped: false,
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: { legend:{ display:false }, tooltip:{ callbacks:{ label: ctx => ` ${ctx.raw} credit hrs` } } },
                scales: {
                    x: { grid:{ display:false }, border:{ display:false } },
                    y: { grid:{ color:'#eef2ff' }, border:{ display:false }, ticks:{ stepSize:4 } }
                }
            }
        });

        // Attendance doughnut
        new Chart(document.getElementById('admin-attendance-chart'), {
            type: 'doughnut',
            data: {
                labels: ['Present','Leave','Absent'],
                datasets: [{ data:[@Model.AttendancePresent,@Model.AttendanceLeave,@Model.AttendanceAbsent], backgroundColor:[INDIGO,SKY,'#c7d2fe'], borderWidth:0, hoverOffset:6 }]
            },
            options: {
                responsive: true, maintainAspectRatio: false, cutout:'72%',
                plugins: { legend:{ display:false }, tooltip:{ callbacks:{ label: ctx => ` ${ctx.raw}%` } } }
            }
        });
    </script>
}

<!-- Greeting -->
<div class="flex items-start justify-between mb-6">
    <div>
        <p class="text-indigo-400 text-sm font-medium">Good morning,</p>
        <h2 class="font-display text-2xl font-bold text-brand-950">System Overview <span class="text-sky-500">↗</span></h2>
    </div>
    <div class="text-right">
        <p class="text-xs text-indigo-400 font-medium">@ViewData["Semester"]</p>
        <p class="text-sm font-semibold text-brand-800">@DateTime.Now.ToString("MMMM dd, yyyy")</p>
    </div>
</div>

<!-- STAT CARDS -->
<div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
    <!-- Total Faculty -->
    <div class="card p-5 space-y-3">
        <div class="h-0.5 w-full bg-gradient-to-r from-indigo-500 to-indigo-400 rounded-full"></div>
        <div class="flex items-start justify-between">
            <div>
                <p class="text-xs font-semibold text-indigo-400 uppercase tracking-wider">Total Faculty</p>
                <p class="font-display text-3xl font-bold text-brand-950 mt-1">@Model.TotalFaculty</p>
                <p class="text-xs text-indigo-300 mt-0.5">Active members</p>
            </div>
            <div class="w-10 h-10 rounded-xl bg-indigo-50 flex items-center justify-center">
                <i data-lucide="users" class="w-5 h-5 text-indigo-500"></i>
            </div>
        </div>
    </div>
    <!-- Departments -->
    <div class="card p-5 space-y-3">
        <div class="h-0.5 w-full bg-gradient-to-r from-sky-500 to-sky-400 rounded-full"></div>
        <div class="flex items-start justify-between">
            <div>
                <p class="text-xs font-semibold text-sky-400 uppercase tracking-wider">Departments</p>
                <p class="font-display text-3xl font-bold text-brand-950 mt-1">@Model.TotalDepartments</p>
                <p class="text-xs text-indigo-300 mt-0.5">Active departments</p>
            </div>
            <div class="w-10 h-10 rounded-xl bg-sky-50 flex items-center justify-center">
                <i data-lucide="building-2" class="w-5 h-5 text-sky-500"></i>
            </div>
        </div>
    </div>
    <!-- Courses -->
    <div class="card p-5 space-y-3">
        <div class="h-0.5 w-full bg-gradient-to-r from-violet-500 to-violet-400 rounded-full"></div>
        <div class="flex items-start justify-between">
            <div>
                <p class="text-xs font-semibold text-violet-400 uppercase tracking-wider">Courses</p>
                <p class="font-display text-3xl font-bold text-brand-950 mt-1">@Model.TotalCourses</p>
                <p class="text-xs text-indigo-300 mt-0.5">This semester</p>
            </div>
            <div class="w-10 h-10 rounded-xl bg-violet-50 flex items-center justify-center">
                <i data-lucide="book-open" class="w-5 h-5 text-violet-500"></i>
            </div>
        </div>
    </div>
    <!-- Pending Leaves -->
    <div class="card p-5 space-y-3">
        <div class="h-0.5 w-full bg-gradient-to-r from-amber-400 to-amber-300 rounded-full"></div>
        <div class="flex items-start justify-between">
            <div>
                <p class="text-xs font-semibold text-amber-400 uppercase tracking-wider">Pending Leaves</p>
                <p class="font-display text-3xl font-bold text-brand-950 mt-1">@Model.PendingLeaves</p>
                <p class="text-xs text-indigo-300 mt-0.5">Awaiting approval</p>
            </div>
            <div class="w-10 h-10 rounded-xl bg-amber-50 flex items-center justify-center">
                <i data-lucide="mail-check" class="w-5 h-5 text-amber-500"></i>
            </div>
        </div>
    </div>
</div>

<!-- CHARTS ROW -->
<div class="grid grid-cols-1 lg:grid-cols-5 gap-4 mb-6">
    <!-- Workload Bar -->
    <div class="card p-5 lg:col-span-3 space-y-4">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-xs font-semibold text-indigo-400 uppercase tracking-wider">Faculty Workload</p>
                <h3 class="font-display font-semibold text-brand-900 text-base">Weekly Credit Hours by Department</h3>
            </div>
            <span class="text-xs font-medium bg-indigo-50 text-indigo-600 px-2.5 py-1 rounded-full border border-indigo-100">@ViewData["Semester"]</span>
        </div>
        <div class="relative h-56">
            <canvas id="admin-workload-chart"></canvas>
        </div>
    </div>
    <!-- Attendance Doughnut -->
    <div class="card p-5 lg:col-span-2 space-y-4">
        <div>
            <p class="text-xs font-semibold text-indigo-400 uppercase tracking-wider">Attendance Rate</p>
            <h3 class="font-display font-semibold text-brand-900 text-base">Semester Overview</h3>
        </div>
        <div class="relative h-44 flex items-center justify-center">
            <canvas id="admin-attendance-chart"></canvas>
            <div class="absolute inset-0 flex flex-col items-center justify-center pointer-events-none">
                <span class="font-display text-3xl font-bold text-brand-950">@Model.AttendancePresent%</span>
                <span class="text-xs text-indigo-400 font-medium">Overall</span>
            </div>
        </div>
        <div class="grid grid-cols-3 gap-2 pt-1">
            <div class="text-center">
                <div class="w-2.5 h-2.5 rounded-full bg-indigo-500 mx-auto mb-1"></div>
                <p class="text-xs font-semibold text-brand-900">@Model.AttendancePresent%</p>
                <p class="text-[10px] text-indigo-300">Present</p>
            </div>
            <div class="text-center">
                <div class="w-2.5 h-2.5 rounded-full bg-sky-400 mx-auto mb-1"></div>
                <p class="text-xs font-semibold text-brand-900">@Model.AttendanceLeave%</p>
                <p class="text-[10px] text-indigo-300">Leave</p>
            </div>
            <div class="text-center">
                <div class="w-2.5 h-2.5 rounded-full bg-indigo-200 mx-auto mb-1"></div>
                <p class="text-xs font-semibold text-brand-900">@Model.AttendanceAbsent%</p>
                <p class="text-[10px] text-indigo-300">Absent</p>
            </div>
        </div>
    </div>
</div>

<!-- BOTTOM ROW -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-4">

    <!-- Pending Leave Requests -->
    <div class="card p-5 space-y-4">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-xs font-semibold text-indigo-400 uppercase tracking-wider">Leave Requests</p>
                <h3 class="font-display font-semibold text-brand-900 text-base">Pending Approval</h3>
            </div>
            <a asp-controller="LeaveApproval" asp-action="Index" class="text-xs font-semibold text-indigo-500 hover:text-indigo-700">View all →</a>
        </div>
        <div class="space-y-3">
            @if (!Model.PendingLeaveRequests.Any())
            {
                <p class="text-sm text-indigo-300 text-center py-4">No pending leave requests.</p>
            }
            @foreach (var leave in Model.PendingLeaveRequests)
            {
                var initials = string.Join("", leave.Emp.Name.Split(' ').Take(2).Select(w => w[0]));
                <div class="flex items-center justify-between py-2.5 border-b border-indigo-50 last:border-0">
                    <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-indigo-400 to-sky-400 flex items-center justify-center text-white text-xs font-bold">
                            @initials
                        </div>
                        <div>
                            <p class="text-sm font-semibold text-brand-900">@leave.Emp.Name</p>
                            <p class="text-xs text-indigo-400">@leave.Emp.Dept?.DeptName · @leave.Lt?.LtName</p>
                        </div>
                    </div>
                    <div class="flex gap-2">
                        <a asp-controller="LeaveApproval" asp-action="Approve" asp-route-id="@leave.LrId"
                           class="text-xs font-semibold bg-emerald-50 text-emerald-600 px-3 py-1 rounded-lg hover:bg-emerald-100">Approve</a>
                        <a asp-controller="LeaveApproval" asp-action="Reject" asp-route-id="@leave.LrId"
                           class="text-xs font-semibold bg-rose-50 text-rose-500 px-3 py-1 rounded-lg hover:bg-rose-100">Reject</a>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Department Workload Progress -->
    <div class="card p-5 space-y-4">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-xs font-semibold text-indigo-400 uppercase tracking-wider">Departments</p>
                <h3 class="font-display font-semibold text-brand-900 text-base">Workload Load %</h3>
            </div>
            <a asp-controller="Reports" asp-action="Index" class="text-xs font-semibold text-indigo-500 hover:text-indigo-700">Full report →</a>
        </div>
        <div class="space-y-3.5">
            @foreach (var dept in Model.DepartmentWorkloads.Take(6))
            {
                var pct = Math.Min((int)dept.LoadPercent, 100);
                var isHigh = pct >= 85;
                var barCls = isHigh ? "bg-gradient-to-r from-amber-400 to-amber-300" : "bg-gradient-to-r from-indigo-500 to-sky-400";
                var txtCls = isHigh ? "text-amber-500" : "text-indigo-600";
                <div>
                    <div class="flex justify-between text-xs mb-1">
                        <span class="font-medium text-brand-800">@dept.DepartmentName</span>
                        <span class="font-semibold @txtCls">@pct%</span>
                    </div>
                    <div class="h-2 bg-indigo-50 rounded-full overflow-hidden">
                        <div class="h-2 @barCls rounded-full prog-fill" style="width:@pct%"></div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
